---
/**
 * IllustrationBand — faixa decorativa fluida com motivos vegetais.
 *
 * Layout não-grid: cada motivo recebe rotação leve e variação de tamanho
 * para evitar sensação de "fileira mecânica". No-wrap responsivo, garante
 * encaixe a partir de 320px.
 *
 * Decisão registrada em ADR-0016. Sempre decorativa (aria-hidden).
 */

import Illustration from "./Illustration.astro";

type Tone = "soft" | "transparent" | "dark";
type Variant = "default" | "wide";

interface Props {
  tone?: Tone;
  variant?: Variant;
  class?: string;
}

const { tone = "soft", variant = "default", class: extra = "" } = Astro.props;

// Motivos com rotação e leve variação de offset vertical pra "respirar".
// Sequência cuidadosamente alternada por cor pra não repetir tom lado a lado.
const items = [
  { kind: "folha",         rotate: -6,  shift:  2,  size: "md" as const },
  { kind: "pimenta",       rotate:  8,  shift: -3,  size: "md" as const },
  { kind: "milho",         rotate: -3,  shift:  3,  size: "md" as const },
  { kind: "cebola",        rotate:  5,  shift: -2,  size: "md" as const },
  { kind: "limao",         rotate: -7,  shift:  1,  size: "md" as const },
  { kind: "tomate",        rotate:  4,  shift: -3,  size: "md" as const },
  { kind: "pao-de-queijo", rotate: -5,  shift:  2,  size: "md" as const },
  { kind: "abacaxi",       rotate:  3,  shift: -2,  size: "md" as const },
  { kind: "alho",          rotate: -4,  shift:  3,  size: "md" as const },
  { kind: "garrafa",       rotate:  6,  shift: -1,  size: "md" as const },
];

const visible = variant === "wide" ? items : items.slice(0, 4);
---

<div class:list={["illus-band", `illus-band--${tone}`, extra]} aria-hidden="true">
  <div class="illus-band__inner">
    {visible.map((it) => (
      <span
        class="illus-band__item"
        style={`--rot: ${it.rotate}deg; --shift: ${it.shift}px;`}
      >
        <Illustration kind={it.kind as "folha"} size={it.size} />
      </span>
    ))}
  </div>
</div>

<style>
  .illus-band {
    width: 100%;
    overflow: hidden;
  }
  .illus-band--soft {
    background: var(--color-bg-soft);
    border-block-start: var(--border-thin);
    border-block-end: var(--border-thin);
  }
  .illus-band--transparent { background: transparent; }
  .illus-band--dark { background: var(--color-surface-strong); }

  .illus-band__inner {
    display: flex;
    align-items: center;
    justify-content: space-around;
    gap: clamp(var(--space-2), 2vw, var(--space-5));
    padding-block: var(--space-3);
    padding-inline: var(--space-3);
    max-width: 720px;
    margin-inline: auto;
  }

  .illus-band__item {
    display: inline-flex;
    transform: translateY(var(--shift, 0)) rotate(var(--rot, 0));
    transform-origin: center;
  }

  /* Mobile pequeno (≤380px): esconde os 2 últimos pra não amassar. */
  @media (max-width: 380px) {
    .illus-band__inner :global(.illus-band__item:nth-child(n + 4)) {
      display: none;
    }
  }
  /* Desktop largo: revela os 6 do "wide" se houverem. */
  @media (min-width: 768px) {
    .illus-band__inner { gap: var(--space-5); }
  }
</style>
