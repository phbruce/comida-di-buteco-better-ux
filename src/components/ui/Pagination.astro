---
/**
 * Pagination — anterior/próximo + páginas numeradas.
 * Recebe currentPage e totalPages; emite URLs via base + query ?page=
 */
interface Props {
  currentPage: number;
  totalPages: number;
  baseUrl: string; /* ex: "/butecos/belo-horizonte/" */
  pageParam?: string;
}

const { currentPage, totalPages, baseUrl, pageParam = "page" } = Astro.props;

if (totalPages < 1) throw new Error("Pagination: totalPages deve ser >= 1");

const buildUrl = (n: number) => (n === 1 ? baseUrl : `${baseUrl}?${pageParam}=${n}`);

const range = (start: number, end: number) =>
  Array.from({ length: end - start + 1 }, (_, i) => start + i);

let pages: (number | "ellipsis")[];
if (totalPages <= 7) {
  pages = range(1, totalPages);
} else {
  const around = range(Math.max(2, currentPage - 1), Math.min(totalPages - 1, currentPage + 1));
  pages = [1];
  if (around[0] > 2) pages.push("ellipsis");
  pages.push(...around);
  if (around[around.length - 1] < totalPages - 1) pages.push("ellipsis");
  pages.push(totalPages);
}

const prev = currentPage > 1 ? buildUrl(currentPage - 1) : null;
const next = currentPage < totalPages ? buildUrl(currentPage + 1) : null;
---

<nav class="pagination" aria-label="Paginação">
  <ul class="pagination__list">
    <li class="pagination__item pagination__item--nav">
      {prev ? (
        <a class="pagination__link pagination__link--prev" href={prev} rel="prev">
          <span aria-hidden="true">&larr;</span> Anterior
        </a>
      ) : (
        <span class="pagination__link pagination__link--disabled" aria-hidden="true">
          &larr; Anterior
        </span>
      )}
    </li>

    {pages.map((p) =>
      p === "ellipsis" ? (
        <li class="pagination__item pagination__item--ellipsis" aria-hidden="true">…</li>
      ) : (
        <li class="pagination__item">
          {p === currentPage ? (
            <span class="pagination__link pagination__link--current" aria-current="page">
              <span class="visually-hidden">Página atual, </span>{p}
            </span>
          ) : (
            <a class="pagination__link" href={buildUrl(p)}>
              <span class="visually-hidden">Página </span>{p}
            </a>
          )}
        </li>
      )
    )}

    <li class="pagination__item pagination__item--nav">
      {next ? (
        <a class="pagination__link pagination__link--next" href={next} rel="next">
          Próxima <span aria-hidden="true">&rarr;</span>
        </a>
      ) : (
        <span class="pagination__link pagination__link--disabled" aria-hidden="true">
          Próxima &rarr;
        </span>
      )}
    </li>
  </ul>
</nav>

<style>
  .pagination {
    margin-block: var(--space-7);
  }
  .pagination__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    justify-content: center;
    align-items: center;
  }
  .pagination__item--nav {
    margin-inline: var(--space-2);
  }
  .pagination__item--ellipsis {
    color: var(--color-text-muted);
    padding: 0 var(--space-2);
  }
  .pagination__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    min-width: 44px;
    min-height: 44px;
    justify-content: center;
    padding: var(--space-2) var(--space-3);
    color: var(--color-brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    border-radius: var(--radius-sm);
  }
  .pagination__link:hover {
    color: var(--color-brand-primary-hover);
    background-color: var(--color-bg-soft);
  }
  .pagination__link--current {
    background-color: var(--color-text-strong);
    color: var(--color-text-on-dark);
    text-decoration: none;
    font-weight: var(--font-weight-bold);
  }
  .pagination__link--disabled {
    color: var(--color-text-muted);
    text-decoration: none;
    cursor: not-allowed;
  }
</style>
