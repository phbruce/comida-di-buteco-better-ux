---
/**
 * Input — wrapper acessível com label visível, hint opcional, mensagem de erro.
 * Sempre renderiza o label antes do input. Hint e error são vinculados via aria-describedby.
 */

interface Props {
  id: string;
  name: string;
  label: string;
  type?: "text" | "search" | "email" | "tel" | "number";
  hint?: string;
  error?: string;
  placeholder?: string;
  value?: string;
  required?: boolean;
  autocomplete?: string;
}

const {
  id,
  name,
  label,
  type = "text",
  hint,
  error,
  placeholder,
  value,
  required = false,
  autocomplete,
} = Astro.props;

const hintId = hint ? `${id}-hint` : undefined;
const errorId = error ? `${id}-error` : undefined;
const describedBy = [hintId, errorId].filter(Boolean).join(" ") || undefined;
---

<div class={`field ${error ? "field--error" : ""}`}>
  <label class="field__label" for={id}>
    {label}
    {required && <span class="field__required" aria-hidden="true">*</span>}
  </label>

  {hint && <p class="field__hint" id={hintId}>{hint}</p>}

  {error && (
    <p class="field__error" id={errorId} role="alert">
      <span class="visually-hidden">Erro: </span>{error}
    </p>
  )}

  <input
    id={id}
    name={name}
    type={type}
    placeholder={placeholder}
    value={value}
    required={required}
    autocomplete={autocomplete}
    aria-describedby={describedBy}
    aria-invalid={error ? "true" : undefined}
    class="field__input"
  />
</div>

<style>
  .field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .field__label {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-strong);
    font-size: var(--font-size-body);
  }
  .field__required {
    color: var(--color-brand-primary);
  }
  .field__hint {
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
    margin: 0;
  }
  .field__error {
    font-size: var(--font-size-small);
    color: var(--color-state-error);
    font-weight: var(--font-weight-semibold);
    border-inline-start: 4px solid var(--color-state-error);
    padding-inline-start: var(--space-3);
    margin: 0;
  }
  .field__input {
    border: var(--border-strong);
    border-radius: var(--radius-none);
  }
  .field--error .field__input {
    border-color: var(--color-state-error);
    border-width: 2px;
  }
</style>
