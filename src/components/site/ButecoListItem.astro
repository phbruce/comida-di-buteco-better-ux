---
/**
 * ButecoListItem — item no estilo "Document list" do GOV.UK.
 *
 * Layout: foto opcional | corpo (título, prato, meta) | chevron
 * - Chevron fica como coluna própria à direita, vertical-centro do item.
 * - Item inteiro clicável via "stretched link" (ele.__link::before cobre o <li>).
 */

import { fotoAltSintetico, type Buteco } from "~/data/butecos";

interface Props {
  buteco: Buteco;
  destacarCidade?: boolean;
  comFoto?: boolean;
}

const { buteco, destacarCidade = false, comFoto = true } = Astro.props;
const base = import.meta.env.BASE_URL;
const detalheUrl = `${base}butecos/${buteco.cidade_slug}/${buteco.slug}/`;
const alt = fotoAltSintetico(buteco);

function normalize(s: string | null | undefined): string {
  if (!s) return "";
  return s.toLocaleLowerCase("pt-BR").normalize("NFD").replace(/[̀-ͯ]/g, "");
}

const searchHaystack = [
  buteco.nome,
  buteco.prato,
  buteco.bairro ?? "",
  buteco.prato_descricao ?? "",
].map(normalize).join(" ");
---

<li
  class={`item ${comFoto ? "item--with-photo" : ""}`}
  data-buteco-item
  data-search={searchHaystack}
  data-bairro={buteco.bairro ?? ""}
  data-nome-key={normalize(buteco.nome)}
  data-bairro-key={normalize(buteco.bairro ?? "")}
>
  <article>
    {comFoto && buteco.foto && (
      <div class="item__media" aria-hidden="true">
        <img
          src={buteco.foto}
          alt=""
          width="200"
          height="134"
          loading="lazy"
          decoding="async"
          referrerpolicy="no-referrer-when-downgrade"
        />
      </div>
    )}
    <div class="item__body">
      <h3 class="item__title">
        <a class="item__link" href={detalheUrl}>{buteco.nome}</a>
      </h3>
      <p class="item__prato">{buteco.prato}</p>
      <p class="item__meta">
        {destacarCidade && (
          <>
            <span class="item__meta-strong">{buteco.cidade}{buteco.uf ? ` — ${buteco.uf}` : ""}</span>
            {buteco.bairro && <span aria-hidden="true"> · </span>}
          </>
        )}
        {buteco.bairro && <span>{buteco.bairro}</span>}
        {buteco.edicao_ano && (
          <>
            <span aria-hidden="true"> · </span>
            <span>Edição {buteco.edicao_ano}</span>
          </>
        )}
      </p>
    </div>
    <span class="item__chevron" aria-hidden="true">›</span>
  </article>
</li>

<style>
  .item {
    border-block-end: var(--border-thin);
    list-style: none;
    position: relative; /* âncora do stretched link */
    transition: background-color var(--motion-fast) var(--easing-standard);
  }
  .item:first-child {
    border-block-start: var(--border-thin);
  }
  .item:hover {
    background-color: var(--color-bg-soft);
  }
  .item article {
    display: grid;
    grid-template-columns: 1fr auto;          /* corpo | chevron */
    column-gap: var(--space-3);
    padding-block: var(--space-4);
    padding-inline-end: var(--space-2);
    align-items: center;                      /* tudo verticalmente centralizado */
  }
  .item--with-photo article {
    grid-template-columns: 96px 1fr auto;     /* foto | corpo | chevron */
  }

  .item__media {
    width: 96px;
    height: 64px;
    overflow: hidden;
    background: var(--color-bg-soft);
    border: var(--border-thin);
    flex-shrink: 0;
    align-self: center;
  }
  .item__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .item__body { min-width: 0; }

  .item__title {
    margin: 0;
    font-size: var(--font-size-h3);
    line-height: var(--line-height-snug);
  }
  .item__link {
    color: var(--color-brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .item__link:hover {
    color: var(--color-brand-primary-hover);
    text-decoration-thickness: 2px;
  }
  /* Stretched link — clique em qualquer ponto do <li> navega para o detalhe */
  .item__link::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .item__link:focus-visible {
    outline: none;
  }
  .item:has(.item__link:focus-visible) {
    outline: var(--focus-outline-width) solid var(--color-focus-ring);
    outline-offset: -2px;
    box-shadow: inset 0 -4px 0 0 var(--color-focus-text);
  }

  .item__prato {
    margin: var(--space-1) 0 0;
    font-size: var(--font-size-body);
    color: var(--color-text-strong);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .item__meta {
    margin: var(--space-1) 0 0;
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
    line-height: var(--line-height-normal);
  }
  .item__meta-strong {
    color: var(--color-text-strong);
    font-weight: var(--font-weight-semibold);
  }

  /* Chevron — coluna própria à direita, grande e centralizada verticalmente */
  .item__chevron {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    font-size: 2rem;
    line-height: 1;
    color: var(--color-text-muted);
    font-weight: var(--font-weight-regular);
    transition: transform var(--motion-fast) var(--easing-standard),
                color var(--motion-fast) var(--easing-standard);
    flex-shrink: 0;
    align-self: center;
  }
  .item:hover .item__chevron {
    color: var(--color-brand-primary);
    transform: translateX(4px);
  }

  @media (min-width: 640px) {
    .item--with-photo article {
      grid-template-columns: 144px 1fr auto;
      column-gap: var(--space-5);
    }
    .item__media {
      width: 144px;
      height: 96px;
    }
    .item__prato {
      font-size: var(--font-size-h3);
      font-weight: var(--font-weight-regular);
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
    }
    .item__chevron {
      width: 40px;
      height: 40px;
      font-size: 2.5rem;
    }
  }
</style>
