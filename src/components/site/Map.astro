---
/**
 * Map — Google Maps Embed via iframe (ADR-0009).
 *
 * Sem chave de API, sem custo. Lazy via toggle "Mostrar mapa" — o iframe
 * só é carregado depois do clique do usuário (consentimento implícito,
 * preserva privacidade até a ação).
 *
 * Quando JS está desabilitado, o toggle não funciona; o usuário continua
 * vendo endereço + "Como chegar" (deep-link para o Google Maps).
 */

interface Props {
  lat: number;
  lng: number;
  label: string;
  enderecoTextual: string;
  mapsUrl: string;
  zoom?: number;
}

const { lat, lng, label, enderecoTextual, mapsUrl, zoom = 16 } = Astro.props;
const id = `map-${Math.random().toString(36).slice(2, 9)}`;
const embedSrc = `https://www.google.com/maps?q=${lat},${lng}&z=${zoom}&output=embed`;
---

<section
  class="map"
  data-map
  data-embed-src={embedSrc}
  data-label={label}
  aria-labelledby={`${id}-title`}
>
  <h3 id={`${id}-title`} class="map__title">Onde fica</h3>

  <p class="map__address">
    <address>{enderecoTextual}</address>
  </p>

  <div class="map__actions">
    <button type="button" class="map__toggle" data-map-toggle aria-expanded="false" aria-controls={id}>
      <span class="map__toggle-icon" aria-hidden="true">⇲</span>
      <span class="map__toggle-text">Mostrar mapa</span>
    </button>
    <a class="map__directions" href={mapsUrl} rel="noopener">Como chegar</a>
  </div>

  <div class="map__container" id={id} aria-hidden="true">
    <p class="map__placeholder" data-map-placeholder>
      Toque em <strong>Mostrar mapa</strong> para carregar a visualização do Google Maps.
    </p>
    <p class="map__privacy">
      Ao mostrar o mapa, você carrega conteúdo do Google que pode usar cookies.
    </p>
  </div>
</section>

<style>
  .map {
    border: var(--border-thin);
    background: var(--color-surface);
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .map__title {
    font-size: var(--font-size-body);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin: 0;
  }
  .map__address { margin: 0; }
  .map__address address {
    font-style: normal;
    line-height: var(--line-height-normal);
  }
  .map__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .map__toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    background-color: var(--color-text-strong);
    color: var(--color-text-on-dark);
    border: 2px solid var(--color-text-strong);
    font: inherit;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }
  .map__toggle:hover {
    background-color: var(--color-brand-primary);
    border-color: var(--color-brand-primary);
  }
  .map__toggle[aria-expanded="true"] {
    background-color: var(--color-bg-canvas);
    color: var(--color-text-strong);
  }
  .map__directions {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    color: var(--color-brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    font-weight: var(--font-weight-semibold);
  }
  .map__directions:hover {
    color: var(--color-brand-primary-hover);
    text-decoration-thickness: 2px;
  }

  .map__container {
    background: var(--color-bg-soft);
    aspect-ratio: 16 / 10;
    overflow: hidden;
    display: none;
    position: relative;
  }
  .map__container.is-active { display: block; }
  .map__placeholder {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    margin: 0;
    padding: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }
  .map__privacy {
    position: absolute;
    inset-block-end: var(--space-2);
    inset-inline: var(--space-3);
    margin: 0;
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    text-align: center;
  }
  .map__container iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }
</style>

<script>
  function setupMap(section: HTMLElement) {
    const toggle = section.querySelector<HTMLButtonElement>("[data-map-toggle]");
    const container = section.querySelector<HTMLElement>(".map__container");
    if (!toggle || !container) return;

    let iframe: HTMLIFrameElement | null = null;

    toggle.addEventListener("click", () => {
      const expanded = toggle.getAttribute("aria-expanded") === "true";
      if (expanded) {
        container.classList.remove("is-active");
        container.setAttribute("aria-hidden", "true");
        toggle.setAttribute("aria-expanded", "false");
        toggle.querySelector(".map__toggle-text")!.textContent = "Mostrar mapa";
      } else {
        container.classList.add("is-active");
        container.setAttribute("aria-hidden", "false");
        toggle.setAttribute("aria-expanded", "true");
        toggle.querySelector(".map__toggle-text")!.textContent = "Esconder mapa";

        if (!iframe) {
          // Cria iframe só na primeira vez (lazy real)
          const src = section.dataset.embedSrc!;
          const label = section.dataset.label ?? "Mapa";
          iframe = document.createElement("iframe");
          iframe.src = src;
          iframe.title = `Mapa do Google mostrando ${label}`;
          iframe.loading = "lazy";
          iframe.referrerPolicy = "no-referrer-when-downgrade";
          // Remove placeholder antes de inserir
          section.querySelector("[data-map-placeholder]")?.remove();
          section.querySelector(".map__privacy")?.remove();
          container.appendChild(iframe);
        }
      }
    });
  }

  for (const el of document.querySelectorAll<HTMLElement>("[data-map]")) {
    setupMap(el);
  }
</script>
