---
/**
 * Footer — rodapé do site.
 * Inclui informações sobre o concurso, links institucionais e crédito.
 */
import OrnamentBand from "~/components/ui/OrnamentBand.astro";

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
---

<OrnamentBand variant="top" tone="soft" height="3.5rem" class="site-footer__ornament" />

<footer class="site-footer" role="contentinfo">
  <div class="site-footer__inner container">
    <section class="site-footer__col" aria-labelledby="ft-sobre">
      <h2 id="ft-sobre">Sobre este redesign</h2>
      <p>
        Projeto <strong>não oficial</strong>, exploratório, focado em UI/UX,
        acessibilidade e mobile-first. Sem vínculo com a organização do concurso.
      </p>
      <p>
        Concurso oficial:
        <a href="https://comidadibuteco.com.br/" rel="noopener">comidadibuteco.com.br</a>
      </p>
      <ul class="site-footer__social" aria-label="Comida di Buteco nas redes sociais (oficial)">
        <li>
          <a
            href="https://www.instagram.com/_comidadibuteco/"
            target="_blank"
            rel="noopener"
            aria-label="Instagram do Comida di Buteco oficial (abre em nova aba)"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <rect x="3" y="3" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"/>
              <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/>
              <rect x="16.25" y="6.25" width="1.5" height="1.5" fill="currentColor"/>
            </svg>
          </a>
        </li>
        <li>
          <a
            href="https://www.facebook.com/comidadibuteco"
            target="_blank"
            rel="noopener"
            aria-label="Facebook do Comida di Buteco oficial (abre em nova aba)"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M14 9h3V6h-3a4 4 0 0 0-4 4v2H7v3h3v6h3v-6h3l1-3h-4v-2a1 1 0 0 1 1-1z"/>
            </svg>
          </a>
        </li>
        <li>
          <a
            href="https://twitter.com/_comidadibuteco"
            target="_blank"
            rel="noopener"
            aria-label="X (Twitter) do Comida di Buteco oficial (abre em nova aba)"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M18.244 3H21l-6.5 7.43L22 21h-6.078l-4.762-6.227L5.7 21H3l6.94-7.93L2 3h6.234l4.305 5.692L18.244 3zm-1.07 16.2h1.69L7.91 4.69H6.1l11.074 14.51z"/>
            </svg>
          </a>
        </li>
        <li>
          <a
            href="https://www.youtube.com/user/canaldocomida"
            target="_blank"
            rel="noopener"
            aria-label="YouTube do Comida di Buteco oficial (abre em nova aba)"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path fill="currentColor" fill-rule="evenodd" d="M2 6h20v12H2V6zm8 2.5l6 3.5-6 3.5v-7z"/>
            </svg>
          </a>
        </li>
      </ul>
    </section>

    <nav class="site-footer__col" aria-labelledby="ft-nav">
      <h2 id="ft-nav">Navegação</h2>
      <ul>
        <li><a href={base}>Início</a></li>
        <li><a href={`${base}sobre/`}>Sobre o redesign</a></li>
        <li>
          <a href="https://comidadibuteco.com.br" rel="noopener">Site oficial do concurso</a>
        </li>
      </ul>
    </nav>

    <section class="site-footer__col" aria-labelledby="ft-acessib">
      <h2 id="ft-acessib">Acessibilidade</h2>
      <p>
        Este site segue WCAG 2.2 AA. Encontrou alguma barreira?
        <a href={`${base}sobre/#acessibilidade`}>Conte para nós</a>.
      </p>
    </section>
  </div>

  <div class="site-footer__bottom">
    <div class="container site-footer__bottom-inner">
      <p class="site-footer__legal">
        Este é um <strong>redesign não oficial</strong> mantido por
        <a href="https://github.com/phbruce" rel="noopener">@phbruce</a> ({year}).
        <br />
        <span class="site-footer__legal-muted">
          "Comida di Buteco" é marca registrada da organização que promove o concurso.
          Conteúdo (nomes de butecos, pratos, fotos) pertence aos respectivos titulares —
          aqui é apresentado a título <em>informativo e exploratório</em>, com link de volta
          ao site oficial.
        </span>
      </p>
      <p class="site-footer__credit">
        Código aberto sob licença MIT:
        <a href="https://github.com/phbruce/comida-di-buteco-better-ux" rel="noopener">
          repositório
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    /* Posicionamento via grid no body — não precisa de margin-top:auto */
    background-color: var(--color-surface-strong);
    color: var(--color-text-on-dark);
  }
  .site-footer a {
    color: var(--color-text-on-dark);
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
  .site-footer a:hover {
    color: var(--color-brand-accent);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    padding-block: var(--space-7);
  }

  .site-footer__col h2 {
    color: var(--color-text-on-dark);
    font-size: var(--font-size-h3);
    margin-block-end: var(--space-3);
  }
  .site-footer__col p {
    color: var(--color-text-on-dark);
    opacity: 0.85;
  }
  .site-footer__col ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  /* Linha de redes sociais — sobrescreve a direção do ul padrão */
  .site-footer__social {
    flex-direction: row !important;
    flex-wrap: wrap;
    margin-block-start: var(--space-3);
  }
  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border: 2px solid currentColor;
    color: var(--color-text-on-dark);
    text-decoration: none;
    transition:
      background-color var(--motion-fast) var(--easing-standard),
      color var(--motion-fast) var(--easing-standard);
  }
  .site-footer__social a:hover,
  .site-footer__social a:focus-visible {
    background: var(--color-brand-accent);
    color: var(--color-text-strong);
    border-color: var(--color-brand-accent);
  }
  .site-footer__social svg {
    width: 22px;
    height: 22px;
    display: block;
  }

  .site-footer__bottom {
    border-block-start: 1px solid rgba(251, 247, 240, 0.15);
    padding-block: var(--space-4);
    font-size: var(--font-size-small);
  }
  .site-footer__bottom-inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    color: var(--color-text-on-dark);
  }
  .site-footer__legal {
    margin: 0;
    line-height: var(--line-height-normal);
  }
  .site-footer__legal-muted {
    color: rgba(251, 247, 240, 0.7);
    font-size: var(--font-size-caption);
  }

  @media (min-width: 640px) {
    .site-footer__inner {
      grid-template-columns: 2fr 1fr 1fr;
      gap: var(--space-7);
    }
    .site-footer__bottom-inner {
      flex-direction: row;
      justify-content: space-between;
    }
  }
</style>
