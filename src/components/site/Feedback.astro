---
/**
 * Feedback — "Esta informação está correta?"
 *
 * Canal de envio escolhido em build conforme env disponível:
 *   1. PUBLIC_FEEDBACK_W3F_KEY  → Web3Forms (ADR-0012, padrão recomendado:
 *      sem signup pro visitante, envio via fetch silencioso, "Obrigado!"
 *      inline).
 *   2. PUBLIC_FEEDBACK_ENDPOINT → Cloudflare Worker (ADR-0006, opção
 *      avançada: cria GitHub Issue automaticamente).
 *   3. nenhum dos dois        → fallback abre Issue do GitHub em nova
 *      aba (exige conta GitHub — só aceitável como último recurso).
 */

interface Props {
  pageId: string;
  pageTitle: string;
  pageUrl: string;
}

const { pageId, pageTitle, pageUrl } = Astro.props;

const w3fKey = import.meta.env.PUBLIC_FEEDBACK_W3F_KEY as string | undefined;
const workerEndpoint = import.meta.env.PUBLIC_FEEDBACK_ENDPOINT as string | undefined;

type Mode = "w3f" | "worker" | "github";
const mode: Mode = w3fKey ? "w3f" : workerEndpoint ? "worker" : "github";

const ghOwner = "phbruce";
const ghRepo = "comida-di-buteco-better-ux";
const ghIssueNew = `https://github.com/${ghOwner}/${ghRepo}/issues/new`;
const W3F_ENDPOINT = "https://api.web3forms.com/submit";

const formAction =
  mode === "w3f" ? W3F_ENDPOINT :
  mode === "worker" ? workerEndpoint! :
  ghIssueNew;

const id = `fb-${pageId}-${Math.random().toString(36).slice(2, 7)}`;

/** URL do GitHub Issue pré-preenchido (modo fallback). */
function ghIssueUrl(rating: "ok" | "bad", message?: string) {
  const params = new URLSearchParams({
    title: `[feedback] ${pageTitle}`,
    labels: `feedback,${rating === "ok" ? "feedback-ok" : "feedback-corrigir"}`,
    body: [
      `**Página:** [${pageTitle}](${pageUrl})`,
      `**ID:** \`${pageId}\``,
      `**Rating:** ${rating === "ok" ? "OK" : "TEM ALGO ERRADO"}`,
      "",
      "**Mensagem:**",
      message ? message : "_(sem mensagem)_",
    ].join("\n"),
  });
  return `${ghIssueNew}?${params.toString()}`;
}

const okHref = ghIssueUrl("ok");
const subjectFmt = `[CdB Redesign] feedback: ${pageTitle}`;
---

<section class="feedback" data-feedback aria-labelledby={`${id}-title`}>
  <div class="feedback__inner container">
    <h2 id={`${id}-title`} class="feedback__title">Esta informação está correta?</h2>
    <p class="feedback__lede">
      Os dados deste buteco vêm do site oficial e podem estar desatualizados.
      Se algo está errado, conta pra gente.
    </p>

    <form
      class="feedback__form"
      method="POST"
      action={formAction}
      data-feedback-form
      data-mode={mode}
      data-gh-ok-url={okHref}
      data-gh-bad-base={ghIssueNew}
      data-page-id={pageId}
      data-page-title={pageTitle}
      data-page-url={pageUrl}
      novalidate
    >
      {/* Web3Forms — campos requeridos */}
      {mode === "w3f" && (
        <>
          <input type="hidden" name="access_key" value={w3fKey} />
          <input type="hidden" name="subject" value={subjectFmt} />
          <input type="hidden" name="from_name" value="CdB Redesign — Feedback" />
          {/* honeypot extra reconhecido pelo Web3Forms */}
          <input
            type="checkbox"
            name="botcheck"
            tabindex="-1"
            class="feedback__honeypot"
            aria-hidden="true"
          />
        </>
      )}

      <input type="hidden" name="pageId" value={pageId} />
      <input type="hidden" name="pageTitle" value={pageTitle} />
      <input type="hidden" name="pageUrl" value={pageUrl} />
      {/* honeypot interno */}
      <input
        type="text"
        name="website"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
        class="feedback__honeypot"
      />

      <div class="feedback__quick" data-feedback-quick>
        {mode === "github" ? (
          <a class="feedback__btn feedback__btn--ok" href={okHref} rel="noopener" data-feedback-ok>
            Sim, está correto
          </a>
        ) : (
          <button type="submit" name="rating" value="ok" class="feedback__btn feedback__btn--ok">
            Sim, está correto
          </button>
        )}
        <button type="button" class="feedback__btn feedback__btn--bad" data-feedback-toggle aria-expanded="false" aria-controls={`${id}-detail`}>
          Tem algo errado
        </button>
      </div>

      <div class="feedback__detail" id={`${id}-detail`} hidden>
        <label class="feedback__label" for={`${id}-text`}>O que está errado?</label>
        <textarea
          id={`${id}-text`}
          name="message"
          rows="3"
          class="feedback__textarea"
          placeholder="Endereço mudou, prato diferente, buteco fechou…"
          maxlength="800"
        ></textarea>
        <p class="feedback__hint">
          {mode === "w3f" && "Seu retorno é enviado por email para a pessoa que mantém o redesign. Não pedimos seu nome nem email."}
          {mode === "worker" && "Seu retorno será publicado como issue pública no repositório do redesign."}
          {mode === "github" && "Você será levado ao GitHub para confirmar o envio. O issue fica público no repositório."}
          {" "}Não inclua dados pessoais.
        </p>
        <div class="feedback__actions">
          <button type="submit" name="rating" value="bad" class="feedback__btn feedback__btn--ok">
            {mode === "github" ? "Abrir issue no GitHub" : "Enviar"}
          </button>
          <button type="button" class="feedback__btn feedback__btn--ghost" data-feedback-cancel>
            Cancelar
          </button>
        </div>
      </div>

      <div class="feedback__thanks" data-feedback-thanks hidden role="status">
        <p><strong>Obrigado!</strong> Anotamos seu retorno.</p>
      </div>
    </form>

    {mode === "github" && (
      <p class="feedback__hint feedback__hint--mode">
        Configure <code>FEEDBACK_W3F_KEY</code> em GitHub Secrets para envio
        sem fricção (ADR-0012). Hoje o feedback abre o GitHub em outra aba.
      </p>
    )}
  </div>
</section>

<style>
  .feedback {
    background: var(--color-bg-soft);
    border-block-start: var(--border-strong);
    border-block-end: var(--border-thin);
    margin-block-start: var(--space-9);
  }
  .feedback__inner {
    padding-block: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .feedback__title {
    font-size: var(--font-size-h2);
    margin: 0;
  }
  .feedback__lede {
    margin: 0;
    color: var(--color-text-muted);
    max-width: 60ch;
  }
  .feedback__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .feedback__honeypot {
    position: absolute;
    inset-inline-start: -9999px;
    opacity: 0;
    pointer-events: none;
  }
  .feedback__quick {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .feedback__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-5);
    border: 2px solid var(--color-border-strong);
    background: var(--color-bg-canvas);
    color: var(--color-text-strong);
    font: inherit;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }
  .feedback__btn:hover {
    background: var(--color-text-strong);
    color: var(--color-text-on-dark);
  }
  .feedback__btn--ok:hover {
    background: var(--color-state-success);
    border-color: var(--color-state-success);
    color: var(--color-text-on-dark);
  }
  .feedback__btn--bad:hover {
    background: var(--color-state-error);
    border-color: var(--color-state-error);
    color: var(--color-text-on-dark);
  }
  .feedback__btn--ghost {
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }
  .feedback__btn--ghost:hover {
    background: var(--color-border);
    color: var(--color-text-strong);
  }

  .feedback__detail[hidden] { display: none; }
  .feedback__detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .feedback__label {
    font-weight: var(--font-weight-semibold);
  }
  .feedback__textarea {
    width: 100%;
    min-height: 88px;
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--color-border-strong);
    background: var(--color-bg-canvas);
    font: inherit;
    line-height: var(--line-height-normal);
    resize: vertical;
  }
  .feedback__hint {
    margin: 0;
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
  }
  .feedback__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .feedback__thanks[hidden] { display: none; }
  .feedback__thanks {
    padding: var(--space-3) var(--space-4);
    background: var(--color-state-success-bg);
    border: 2px solid var(--color-state-success);
    color: var(--color-state-success);
  }

  .feedback__fallback {
    margin: 0;
  }
</style>

<script>
  type Mode = "idle" | "detail" | "sending" | "thanks";

  function setupOne(section: HTMLElement) {
    const form = section.querySelector<HTMLFormElement>("[data-feedback-form]");
    if (!form) return;
    const detail = section.querySelector<HTMLElement>("[data-feedback-toggle]")?.getAttribute("aria-controls");
    const detailEl = detail ? document.getElementById(detail) : null;
    const thanks = section.querySelector<HTMLElement>("[data-feedback-thanks]");
    const quick = section.querySelector<HTMLElement>("[data-feedback-quick]");
    const toggle = section.querySelector<HTMLButtonElement>("[data-feedback-toggle]");
    const cancel = section.querySelector<HTMLButtonElement>("[data-feedback-cancel]");

    function setMode(mode: Mode) {
      switch (mode) {
        case "idle":
          quick?.removeAttribute("hidden");
          detailEl?.setAttribute("hidden", "");
          thanks?.setAttribute("hidden", "");
          toggle?.setAttribute("aria-expanded", "false");
          break;
        case "detail":
          quick?.setAttribute("hidden", "");
          detailEl?.removeAttribute("hidden");
          toggle?.setAttribute("aria-expanded", "true");
          (detailEl?.querySelector("textarea") as HTMLTextAreaElement | null)?.focus();
          break;
        case "thanks":
          quick?.setAttribute("hidden", "");
          detailEl?.setAttribute("hidden", "");
          thanks?.removeAttribute("hidden");
          break;
      }
    }

    toggle?.addEventListener("click", () => setMode("detail"));
    cancel?.addEventListener("click", () => setMode("idle"));

    const mode = (form.dataset.mode ?? "github") as "github" | "worker" | "w3f";

    form.addEventListener("submit", async (e) => {
      // honeypot — bot preencheu? aborta silenciosamente
      const wp = form.elements.namedItem("website") as HTMLInputElement | null;
      const bc = form.elements.namedItem("botcheck") as HTMLInputElement | null;
      if (wp?.value || bc?.checked) {
        e.preventDefault();
        setMode("thanks");
        return;
      }

      e.preventDefault();
      const data = new FormData(form);
      const rating = (data.get("rating") as string | null) ?? "bad";
      const message = (data.get("message") as string | null) ?? "";

      if (mode === "github") {
        // monta URL do GitHub Issue pré-preenchido e abre em nova aba
        const ghBase = form.dataset.ghBadBase ?? "https://github.com/issues/new";
        const pageId = form.dataset.pageId ?? "";
        const pageTitle = form.dataset.pageTitle ?? "";
        const pageUrl = form.dataset.pageUrl ?? "";
        const params = new URLSearchParams({
          title: `[feedback] ${pageTitle}`,
          labels: `feedback,${rating === "ok" ? "feedback-ok" : "feedback-corrigir"}`,
          body: [
            `**Página:** [${pageTitle}](${pageUrl})`,
            `**ID:** \`${pageId}\``,
            `**Rating:** ${rating === "ok" ? "OK" : "TEM ALGO ERRADO"}`,
            "",
            "**Mensagem:**",
            message || "_(sem mensagem)_",
          ].join("\n"),
        });
        window.open(`${ghBase}?${params.toString()}`, "_blank", "noopener");
        setMode("thanks");
        return;
      }

      // modo w3f / worker: POST com fetch silencioso, "Obrigado!" inline
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: data,
          headers: { Accept: "application/json" },
        });
        if (!res.ok && res.status !== 0) {
          throw new Error(`HTTP ${res.status}`);
        }
      } catch (err) {
        console.warn("[feedback] fallback envio:", err);
        form.submit();
        return;
      }
      setMode("thanks");
    });
  }

  for (const el of document.querySelectorAll<HTMLElement>("[data-feedback]")) {
    setupOne(el);
  }
</script>
