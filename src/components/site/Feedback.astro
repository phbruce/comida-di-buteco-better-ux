---
/**
 * Feedback — "Esta informação está correta?"
 *
 * Canal de envio escolhido em build conforme env disponível:
 *   1. PUBLIC_FEEDBACK_W3F_KEY  → Web3Forms (ADR-0012, padrão recomendado:
 *      sem signup pro visitante, envio via fetch silencioso, "Obrigado!"
 *      inline).
 *   2. PUBLIC_FEEDBACK_ENDPOINT → Cloudflare Worker (ADR-0006, opção
 *      avançada: cria GitHub Issue automaticamente).
 *   3. nenhum dos dois        → fallback abre Issue do GitHub em nova
 *      aba (exige conta GitHub — só aceitável como último recurso).
 */

interface Props {
  pageId: string;
  pageTitle: string;
  pageUrl: string;
}

const { pageId, pageTitle, pageUrl } = Astro.props;

const w3fKey = import.meta.env.PUBLIC_FEEDBACK_W3F_KEY as string | undefined;
const workerEndpoint = import.meta.env.PUBLIC_FEEDBACK_ENDPOINT as string | undefined;
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;

type Mode = "w3f" | "worker" | "github";
const mode: Mode = w3fKey ? "w3f" : workerEndpoint ? "worker" : "github";

const ghOwner = "phbruce";
const ghRepo = "comida-di-buteco-better-ux";
const ghIssueNew = `https://github.com/${ghOwner}/${ghRepo}/issues/new`;
const W3F_ENDPOINT = "https://api.web3forms.com/submit";

const formAction =
  mode === "w3f" ? W3F_ENDPOINT :
  mode === "worker" ? workerEndpoint! :
  ghIssueNew;

const id = `fb-${pageId}-${Math.random().toString(36).slice(2, 7)}`;

/** URL do GitHub Issue pré-preenchido (modo fallback). */
function ghIssueUrl(rating: "ok" | "bad", message?: string) {
  const params = new URLSearchParams({
    title: `[feedback] ${pageTitle}`,
    labels: `feedback,${rating === "ok" ? "feedback-ok" : "feedback-corrigir"}`,
    body: [
      `**Página:** [${pageTitle}](${pageUrl})`,
      `**ID:** \`${pageId}\``,
      `**Rating:** ${rating === "ok" ? "OK" : "TEM ALGO ERRADO"}`,
      "",
      "**Mensagem:**",
      message ? message : "_(sem mensagem)_",
    ].join("\n"),
  });
  return `${ghIssueNew}?${params.toString()}`;
}

const okHref = ghIssueUrl("ok");
const subjectFmt = `[CdB Redesign] feedback: ${pageTitle}`;
---

<section class="feedback" data-feedback aria-labelledby={`${id}-title`}>
  <div class="feedback__inner container">
    <h2 id={`${id}-title`} class="feedback__title">Esta informação está correta?</h2>
    <p class="feedback__lede">
      Os dados deste buteco vêm do site oficial e podem estar desatualizados.
      Se algo está errado, conta pra gente.
    </p>

    <form
      class="feedback__form"
      method="POST"
      action={formAction}
      data-feedback-form
      data-mode={mode}
      data-gh-ok-url={okHref}
      data-gh-bad-base={ghIssueNew}
      data-page-id={pageId}
      data-page-title={pageTitle}
      data-page-url={pageUrl}
      novalidate
    >
      {/* Web3Forms — campos requeridos */}
      {mode === "w3f" && (
        <>
          <input type="hidden" name="access_key" value={w3fKey} />
          <input type="hidden" name="subject" value={subjectFmt} />
          <input type="hidden" name="from_name" value="CdB Redesign — Feedback" />
          {/* honeypot extra reconhecido pelo Web3Forms */}
          <input
            type="checkbox"
            name="botcheck"
            tabindex="-1"
            class="feedback__honeypot"
            aria-hidden="true"
          />
        </>
      )}

      <input type="hidden" name="pageId" value={pageId} />
      <input type="hidden" name="pageTitle" value={pageTitle} />
      <input type="hidden" name="pageUrl" value={pageUrl} />
      {/* honeypot interno */}
      <input
        type="text"
        name="website"
        tabindex="-1"
        autocomplete="off"
        aria-hidden="true"
        class="feedback__honeypot"
      />

      <div class="feedback__quick" data-feedback-quick>
        {mode === "github" ? (
          <a class="feedback__btn feedback__btn--ok" href={okHref} rel="noopener" data-feedback-ok>
            Sim, está correto
          </a>
        ) : (
          <button
            type="submit"
            name="rating"
            value="ok"
            class="feedback__btn feedback__btn--ok"
            data-rating="ok"
          >
            Sim, está correto
          </button>
        )}
        <button
          type="button"
          class="feedback__btn feedback__btn--bad"
          data-feedback-toggle
          data-rating="bad"
          aria-expanded="false"
          aria-controls={`${id}-detail`}
        >
          Tem algo errado
        </button>
      </div>

      <div class="feedback__detail" id={`${id}-detail`} hidden>
        <label class="feedback__label" for={`${id}-text`}>O que está errado?</label>
        <textarea
          id={`${id}-text`}
          name="message"
          rows="3"
          class="feedback__textarea"
          placeholder="Endereço mudou, prato diferente, buteco fechou…"
          maxlength="800"
        ></textarea>
        <p class="feedback__hint">
          {mode === "w3f" && "Seu retorno é enviado por email para a pessoa que mantém o redesign. Não pedimos seu nome nem email."}
          {mode === "worker" && "Seu retorno será publicado como issue pública no repositório do redesign."}
          {mode === "github" && "Você será levado ao GitHub para confirmar o envio. O issue fica público no repositório."}
          {" "}Não inclua dados pessoais.
        </p>
        {turnstileKey && (
          <div class="feedback__turnstile">
            <div
              class="cf-turnstile"
              data-sitekey={turnstileKey}
              data-theme="light"
              data-appearance="interaction-only"
              data-language="pt-br"
            ></div>
          </div>
        )}
        <div class="feedback__actions">
          <button
            type="submit"
            name="rating"
            value="bad"
            class="feedback__btn feedback__btn--ok"
            data-rating="bad"
          >
            {mode === "github" ? "Abrir issue no GitHub" : "Enviar"}
          </button>
          <button type="button" class="feedback__btn feedback__btn--ghost" data-feedback-cancel>
            Cancelar
          </button>
        </div>
      </div>

      <div class="feedback__thanks" data-feedback-thanks hidden role="status">
        <p data-feedback-thanks-msg><strong>Obrigado!</strong> Anotamos seu retorno.</p>
        <p class="feedback__hint">
          <button type="button" class="feedback__undo" data-feedback-undo>Mudei de ideia</button>
        </p>
      </div>
    </form>

    {mode === "github" && (
      <p class="feedback__hint feedback__hint--mode">
        Configure <code>FEEDBACK_W3F_KEY</code> em GitHub Secrets para envio
        sem fricção (ADR-0012). Hoje o feedback abre o GitHub em outra aba.
      </p>
    )}
  </div>
</section>

{turnstileKey && (
  <script
    is:inline
    src="https://challenges.cloudflare.com/turnstile/v0/api.js"
    async
    defer
  ></script>
)}

<style>
  .feedback {
    background: var(--color-bg-soft);
    border-block-start: var(--border-strong);
    border-block-end: var(--border-thin);
    margin-block-start: var(--space-9);
  }
  .feedback__inner {
    padding-block: var(--space-7);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .feedback__title {
    font-size: var(--font-size-h2);
    margin: 0;
  }
  .feedback__lede {
    margin: 0;
    color: var(--color-text-muted);
    max-width: 60ch;
  }
  .feedback__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .feedback__honeypot {
    position: absolute;
    inset-inline-start: -9999px;
    opacity: 0;
    pointer-events: none;
  }
  .feedback__quick {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .feedback__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-5);
    border: 2px solid var(--color-border-strong);
    background: var(--color-bg-canvas);
    color: var(--color-text-strong);
    font: inherit;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }
  .feedback__btn:hover {
    background: var(--color-text-strong);
    color: var(--color-text-on-dark);
  }
  .feedback__btn--ok:hover {
    background: var(--color-state-success);
    border-color: var(--color-state-success);
    color: var(--color-text-on-dark);
  }
  .feedback__btn--bad:hover {
    background: var(--color-state-error);
    border-color: var(--color-state-error);
    color: var(--color-text-on-dark);
  }
  .feedback__btn--ghost {
    border-color: var(--color-border);
    color: var(--color-text-muted);
  }
  .feedback__btn--ghost:hover {
    background: var(--color-border);
    color: var(--color-text-strong);
  }
  /* Botão travado depois do submit (clicado ou inverso) */
  .feedback__btn[disabled],
  .feedback__btn[aria-disabled="true"] {
    opacity: 0.45;
    cursor: not-allowed;
    pointer-events: none;
  }
  .feedback__btn--sending {
    opacity: 0.7;
    cursor: progress;
    pointer-events: none;
  }

  /* Link "Mudei de ideia" — visual de link plain dentro do thanks */
  .feedback__undo {
    background: transparent;
    border: 0;
    padding: 0;
    color: var(--color-brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    font: inherit;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }
  .feedback__undo:hover {
    color: var(--color-brand-primary-hover);
    text-decoration-thickness: 2px;
  }

  .feedback__detail[hidden] { display: none; }
  .feedback__detail {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .feedback__label {
    font-weight: var(--font-weight-semibold);
  }
  .feedback__textarea {
    width: 100%;
    min-height: 88px;
    padding: var(--space-3) var(--space-4);
    border: 2px solid var(--color-border-strong);
    background: var(--color-bg-canvas);
    font: inherit;
    line-height: var(--line-height-normal);
    resize: vertical;
  }
  .feedback__hint {
    margin: 0;
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
  }
  .feedback__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .feedback__thanks[hidden] { display: none; }
  .feedback__thanks {
    padding: var(--space-3) var(--space-4);
    background: var(--color-state-success-bg);
    border: 2px solid var(--color-state-success);
    color: var(--color-state-success);
  }

  .feedback__fallback {
    margin: 0;
  }

  .feedback__turnstile {
    margin-block-start: var(--space-2);
    min-height: 65px;   /* reserva espaço pro widget pra evitar CLS */
  }
</style>

<script>
  type Mode = "idle" | "detail" | "sending" | "thanks" | "throttled";

  /** Rate limit cliente — armazenado em localStorage. Estende o free tier
      do Web3Forms e barra abuso casual. NÃO substitui defesa server-side
      (Turnstile, Web3Forms próprio rate limit por IP). */
  const RATE_LIMITS = [
    { windowMs: 60 * 1000,            max: 1,  key: "cdb-fb-rl-min" },
    { windowMs: 60 * 60 * 1000,       max: 5,  key: "cdb-fb-rl-hour" },
    { windowMs: 24 * 60 * 60 * 1000,  max: 20, key: "cdb-fb-rl-day" },
  ];
  /** Tempo mínimo entre o form abrir e o submit (anti-bot leve). */
  const MIN_DWELL_MS = 2000;

  function checkRateLimit(): { ok: true } | { ok: false; retryAfterMs: number; label: string } {
    const now = Date.now();
    try {
      for (const limit of RATE_LIMITS) {
        const arr: number[] = JSON.parse(localStorage.getItem(limit.key) ?? "[]");
        const recent = arr.filter((t) => now - t < limit.windowMs);
        if (recent.length >= limit.max) {
          const oldest = Math.min(...recent);
          const retryAfterMs = limit.windowMs - (now - oldest);
          const label =
            limit.windowMs <= 60_000 ? "alguns segundos" :
            limit.windowMs <= 3_600_000 ? "alguns minutos" : "algumas horas";
          return { ok: false, retryAfterMs, label };
        }
      }
    } catch {
      // localStorage indisponível (ex.: modo privado strict) — não bloqueia
    }
    return { ok: true };
  }

  function recordSubmit() {
    const now = Date.now();
    try {
      for (const limit of RATE_LIMITS) {
        const arr: number[] = JSON.parse(localStorage.getItem(limit.key) ?? "[]");
        arr.push(now);
        const trimmed = arr.filter((t) => now - t < limit.windowMs);
        localStorage.setItem(limit.key, JSON.stringify(trimmed));
      }
    } catch { /* ignora */ }
  }

  function setupOne(section: HTMLElement) {
    const form = section.querySelector<HTMLFormElement>("[data-feedback-form]");
    if (!form) return;
    const detailId = section.querySelector<HTMLElement>("[data-feedback-toggle]")?.getAttribute("aria-controls");
    const detailEl = detailId ? document.getElementById(detailId) : null;
    const thanks = section.querySelector<HTMLElement>("[data-feedback-thanks]");
    const thanksMsg = section.querySelector<HTMLElement>("[data-feedback-thanks-msg]");
    const quick = section.querySelector<HTMLElement>("[data-feedback-quick]");
    const toggle = section.querySelector<HTMLButtonElement>("[data-feedback-toggle]");
    const cancel = section.querySelector<HTMLButtonElement>("[data-feedback-cancel]");
    const undoBtn = section.querySelector<HTMLButtonElement>("[data-feedback-undo]");
    const submitButtons = Array.from(form.querySelectorAll<HTMLButtonElement>('button[type="submit"]'));
    const ratingButtons = Array.from(section.querySelectorAll<HTMLElement>("[data-rating]"));

    /** Quando a seção foi montada — usado pra checar tempo mínimo de dwell. */
    const mountedAt = Date.now();

    /** Trava global do componente: enquanto há request em voo OU já foi
        enviado nesta sessão da página. Evita race entre cliques duplos. */
    let inFlight = false;
    let submitted: "ok" | "bad" | null = null;

    /** Reseta UI + estado para idle (chamado pelo "Mudei de ideia"). */
    function reset() {
      submitted = null;
      inFlight = false;
      // limpa textarea
      const ta = section.querySelector<HTMLTextAreaElement>('textarea[name="message"]');
      if (ta) ta.value = "";
      // restaura botões de submit
      submitButtons.forEach((b) => {
        b.disabled = false;
        b.classList.remove("feedback__btn--sending");
      });
      ratingButtons.forEach((b) => {
        b.removeAttribute("aria-disabled");
      });
      if (toggle) toggle.removeAttribute("aria-disabled");
      // restaura mensagem de Obrigado padrão
      if (thanksMsg) thanksMsg.innerHTML = "<strong>Obrigado!</strong> Anotamos seu retorno.";
      setMode("idle");
    }

    /** Bloqueia ambos os caminhos de voto após submit confirmado.
        Mantém só o link "Mudei de ideia" como saída. */
    function lockAfterSubmit(rating: "ok" | "bad") {
      submitted = rating;
      submitButtons.forEach((b) => {
        b.disabled = true;
        b.classList.remove("feedback__btn--sending");
      });
      ratingButtons.forEach((b) => b.setAttribute("aria-disabled", "true"));
      if (toggle) toggle.setAttribute("aria-disabled", "true");
    }

    function setMode(mode: Mode) {
      // SEMPRE esconde os 3 painéis e revela só o ativo — evita
      // sobreposição (bug em que "Obrigado" persistia ao expandir o detail).
      quick?.setAttribute("hidden", "");
      detailEl?.setAttribute("hidden", "");
      thanks?.setAttribute("hidden", "");
      toggle?.setAttribute("aria-expanded", "false");

      switch (mode) {
        case "idle":
          quick?.removeAttribute("hidden");
          break;
        case "detail":
          detailEl?.removeAttribute("hidden");
          toggle?.setAttribute("aria-expanded", "true");
          (detailEl?.querySelector("textarea") as HTMLTextAreaElement | null)?.focus();
          break;
        case "thanks":
        case "throttled":
          thanks?.removeAttribute("hidden");
          break;
      }
    }

    toggle?.addEventListener("click", (e) => {
      // se já enviou ou está em voo, ignora — só "Mudei de ideia" libera
      if (submitted || inFlight) {
        e.preventDefault();
        return;
      }
      setMode("detail");
    });
    cancel?.addEventListener("click", () => {
      if (inFlight) return;
      setMode("idle");
    });
    undoBtn?.addEventListener("click", () => reset());

    const mode = (form.dataset.mode ?? "github") as "github" | "worker" | "w3f";

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Trava 1: já há request em voo OU já foi enviado nesta sessão.
      // Evita race em duplo-clique e enviar inverso depois de votar.
      if (inFlight || submitted) {
        return;
      }

      // Trava 2: honeypot — bot preencheu? aborta silenciosamente.
      const wp = form.elements.namedItem("website") as HTMLInputElement | null;
      const bc = form.elements.namedItem("botcheck") as HTMLInputElement | null;
      if (wp?.value || bc?.checked) {
        if (thanksMsg) thanksMsg.innerHTML = "<strong>Obrigado!</strong> Anotamos seu retorno.";
        setMode("thanks");
        return;
      }

      // Trava 3: anti-bot leve — form precisa estar visível há pelo menos 2s.
      if (Date.now() - mountedAt < MIN_DWELL_MS) {
        if (thanksMsg) thanksMsg.innerHTML = "<strong>Obrigado!</strong> Anotamos seu retorno.";
        setMode("thanks");
        return;
      }

      // Trava 4: rate limit cliente — bloqueia abuso casual.
      const rl = checkRateLimit();
      if (!rl.ok) {
        if (thanksMsg) {
          thanksMsg.innerHTML =
            "<strong>Espera só um pouco.</strong> Já recebemos um " +
            "feedback seu há pouco — tente de novo em " + rl.label + ".";
        }
        setMode("throttled");
        return;
      }

      // Captura o botão que disparou o submit — sem isso,
      // FormData(form) não inclui o name="rating" do <button submit>.
      const submitter = (e as SubmitEvent).submitter as HTMLButtonElement | null;
      const data = new FormData(form, submitter ?? undefined);
      // fallback caso o browser não suporte o 2º argumento de FormData
      if (!data.get("rating") && submitter?.getAttribute("name") === "rating") {
        data.set("rating", submitter.value || "bad");
      }

      const rating = ((data.get("rating") as string | null) ?? "bad") as "ok" | "bad";
      const message = (data.get("message") as string | null) ?? "";
      const pageId = form.dataset.pageId ?? "";
      const pageTitle = form.dataset.pageTitle ?? "";
      const pageUrl = form.dataset.pageUrl ?? "";

      // Trava: marca em voo e desabilita botões ANTES de qualquer ação async.
      inFlight = true;
      submitButtons.forEach((b) => {
        b.disabled = true;
        if (submitter && b === submitter) b.classList.add("feedback__btn--sending");
      });

      if (mode === "github") {
        // monta URL do GitHub Issue pré-preenchido e abre em nova aba
        const ghBase = form.dataset.ghBadBase ?? "https://github.com/issues/new";
        const params = new URLSearchParams({
          title: `[feedback] ${pageTitle}`,
          labels: `feedback,${rating === "ok" ? "feedback-ok" : "feedback-corrigir"}`,
          body: [
            `**Página:** [${pageTitle}](${pageUrl})`,
            `**ID:** \`${pageId}\``,
            `**Rating:** ${rating === "ok" ? "OK" : "TEM ALGO ERRADO"}`,
            "",
            "**Mensagem:**",
            message || "_(sem mensagem)_",
          ].join("\n"),
        });
        window.open(`${ghBase}?${params.toString()}`, "_blank", "noopener");
        recordSubmit();
        if (thanksMsg) thanksMsg.innerHTML = "<strong>Obrigado!</strong> Anotamos seu retorno.";
        lockAfterSubmit(rating);
        setMode("thanks");
        return;
      }

      if (mode === "w3f") {
        // Consolida tudo num único campo `message` para email mais legível
        // e remove os campos extras (Web3Forms encaminha tudo o que vier).
        const composite = [
          `Avaliação: ${rating === "ok" ? "OK — está correto" : "TEM ALGO ERRADO"}`,
          `Página: ${pageTitle}`,
          `URL: ${pageUrl}`,
          `ID interno: ${pageId}`,
          "",
          "Mensagem do visitante:",
          message || "(sem mensagem)",
        ].join("\n");
        data.delete("pageId");
        data.delete("pageTitle");
        data.delete("pageUrl");
        data.delete("rating");
        data.delete("website");   // honeypot custom
        data.delete("botcheck");  // honeypot Web3Forms
        data.set("message", composite);
      }

      // POST com fetch silencioso (modo w3f / worker), "Obrigado!" inline
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: data,
          headers: { Accept: "application/json" },
        });
        if (!res.ok && res.status !== 0) {
          throw new Error(`HTTP ${res.status}`);
        }
        recordSubmit();
      } catch (err) {
        console.warn("[feedback] fallback envio:", err);
        // libera trava e deixa o navegador submeter (URL fora de eixo)
        inFlight = false;
        submitButtons.forEach((b) => {
          b.disabled = false;
          b.classList.remove("feedback__btn--sending");
        });
        form.submit();
        return;
      }
      if (thanksMsg) thanksMsg.innerHTML = "<strong>Obrigado!</strong> Anotamos seu retorno.";
      lockAfterSubmit(rating);
      inFlight = false;
      setMode("thanks");
    });
  }

  for (const el of document.querySelectorAll<HTMLElement>("[data-feedback]")) {
    setupOne(el);
  }
</script>
