---
/**
 * ButecoCard — card de listagem.
 *
 * Atende RF-0001:
 * - Nome, prato, bairro, foto, indicadores (premiado/estreante/edição).
 * - Card é totalmente clicável via "stretched link" no nome.
 *
 * Foto é HOTLINK (não redistribuída). Ver docs/CONTEXTO.md (natureza não oficial).
 */

import Tag from "~/components/ui/Tag.astro";
import { fotoAltSintetico, type Buteco } from "~/data/butecos";

interface Props {
  buteco: Buteco;
  destacarCidade?: boolean;
}

const { buteco, destacarCidade = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const detalheUrl = `${base}butecos/${buteco.cidade_slug}/${buteco.slug}/`;
const alt = fotoAltSintetico(buteco);
---

<article class="card">
  <div class="card__media">
    {buteco.foto ? (
      <img
        src={buteco.foto}
        srcset={buteco.foto_srcset ?? undefined}
        sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
        alt={alt}
        width="800"
        height="500"
        loading="lazy"
        decoding="async"
        referrerpolicy="no-referrer-when-downgrade"
      />
    ) : (
      <div class="card__media-placeholder" aria-hidden="true">
        <span>{buteco.prato.charAt(0)}</span>
      </div>
    )}
  </div>

  <div class="card__body">
    <header class="card__header">
      <h3 class="card__title">
        <a class="card__link" href={detalheUrl}>{buteco.nome}</a>
      </h3>
      <p class="card__sub">
        {destacarCidade && (
          <>
            <span class="visually-hidden">Cidade: </span>
            <span class="card__cidade">{buteco.cidade}{buteco.uf ? ` — ${buteco.uf}` : ""}</span>
            <span aria-hidden="true"> · </span>
          </>
        )}
        {buteco.bairro && (
          <>
            <span class="visually-hidden">Bairro: </span>
            <span>{buteco.bairro}</span>
          </>
        )}
      </p>
    </header>

    <div class="card__prato">
      <p class="card__prato-label">Prato concorrente</p>
      <p class="card__prato-nome">{buteco.prato}</p>
      {buteco.prato_descricao && (
        <p class="card__prato-desc">{buteco.prato_descricao}</p>
      )}
    </div>

    {buteco.edicao_ano && buteco.edicao_ano >= 2026 && (
      <footer class="card__footer">
        <Tag variant="neutral">Edição {buteco.edicao_ano}</Tag>
      </footer>
    )}
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    background-color: var(--color-surface);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--motion-fast) var(--easing-standard),
                transform var(--motion-fast) var(--easing-standard),
                box-shadow var(--motion-base) var(--easing-standard);
  }

  .card:hover {
    border-color: var(--color-text-strong);
    box-shadow: var(--shadow-2);
  }

  .card__link::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .card__link {
    color: var(--color-brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
  }
  .card:hover .card__link,
  .card__link:focus-visible {
    text-decoration-thickness: 2px;
    color: var(--color-brand-primary-hover);
  }
  .card__link:focus-visible {
    outline: none;
  }
  .card:has(.card__link:focus-visible) {
    outline: var(--focus-outline-width) solid var(--color-focus-ring);
    outline-offset: var(--focus-offset);
    box-shadow: 0 4px 0 0 var(--color-focus-text);
  }

  .card__media {
    position: relative;
    background-color: var(--color-bg-soft);
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .card__media-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--color-bg-soft), var(--color-surface));
    color: var(--color-text-muted);
    font-size: 4rem;
    font-weight: var(--font-weight-bold);
    letter-spacing: -0.04em;
  }

  .card__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-4);
    flex: 1;
  }

  .card__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }
  .card__title {
    margin: 0;
    font-size: var(--font-size-h3);
    line-height: var(--line-height-snug);
  }
  .card__sub {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }
  .card__cidade {
    color: var(--color-text-strong);
    font-weight: var(--font-weight-semibold);
  }

  .card__prato-label {
    margin: 0;
    font-size: var(--font-size-caption);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    font-weight: var(--font-weight-semibold);
  }
  .card__prato-nome {
    margin: 0;
    font-weight: var(--font-weight-semibold);
    font-size: var(--font-size-body);
  }
  .card__prato-desc {
    margin: var(--space-1) 0 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    line-height: var(--line-height-normal);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card__footer {
    margin-block-start: auto;
  }
</style>
