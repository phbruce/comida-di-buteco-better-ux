---
/**
 * Comments — sistema próprio de comentários (ADR-0015).
 *
 * Lista + formulário consumindo nosso Cloudflare Worker. UI 100% no
 * design system, sem iframe. Lazy-loaded via IntersectionObserver.
 *
 * Envs:
 *   PUBLIC_COMMENTS_ENDPOINT  — URL do worker (ex.: https://cdb-comments.x.workers.dev)
 *   PUBLIC_TURNSTILE_SITE_KEY — site key do widget Turnstile (anti-bot)
 *
 * Sem PUBLIC_COMMENTS_ENDPOINT, mostra fallback "indisponível".
 */

interface Props {
  pageId: string;
  pageTitle: string;
  pageUrl: string;
}

const { pageId, pageTitle, pageUrl } = Astro.props;

const endpoint = (import.meta.env.PUBLIC_COMMENTS_ENDPOINT as string | undefined)?.replace(/\/$/, "");
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;
---

<section class="comments" data-comments aria-labelledby="comments-title">
  <div class="container">
    <h2 id="comments-title" class="comments__title">Comentários</h2>
    <p class="comments__lede">
      Já visitou? Conta sua experiência. Você pode comentar com apelido
      livre, sem cadastro nem email.
    </p>

    {endpoint ? (
      <div
        class="comments__mount"
        data-comments-mount
        data-endpoint={endpoint}
        data-page-id={pageId}
        data-page-title={pageTitle}
        data-page-url={pageUrl}
      >
        {/* Estado inicial — substituído quando JS carrega */}
        <p class="comments__placeholder">Carregando comentários…</p>
      </div>
    ) : (
      <p class="comments__fallback">
        <strong>Comentários temporariamente indisponíveis.</strong>
        {" "}Configure <code>COMMENTS_ENDPOINT</code> em GitHub Secrets
        após deploy do Worker (ADR-0015).
      </p>
    )}
  </div>
</section>

<style>
  .comments {
    padding-block: var(--space-7);
    border-block-start: var(--border-thin);
  }
  .comments__title {
    font-size: var(--font-size-h2);
    margin-block-end: var(--space-3);
  }
  .comments__lede {
    color: var(--color-text-muted);
    max-width: 60ch;
    margin-block-end: var(--space-5);
  }
  .comments__placeholder,
  .comments__fallback {
    padding: var(--space-5);
    background: var(--color-bg-soft);
    border: var(--border-thin);
    color: var(--color-text-muted);
    text-align: center;
  }
  .comments__fallback {
    text-align: start;
  }
  .comments__fallback code {
    background: var(--color-bg-canvas);
    padding: 1px 4px;
    border: var(--border-thin);
    font-size: 0.92em;
  }
</style>

<style is:global>
  /* ---------- Lista de comentários ---------- */
  .cmt__list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-7);
  }
  .cmt__item {
    border-block-end: var(--border-thin);
    padding: var(--space-4) 0;
  }
  .cmt__item:first-child {
    border-block-start: var(--border-thin);
  }
  .cmt__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    margin-block-end: var(--space-2);
  }
  .cmt__nick {
    font-weight: var(--font-weight-bold);
    color: var(--color-text-strong);
  }
  .cmt__time {
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
  }
  .cmt__msg {
    margin: 0;
    color: var(--color-text-strong);
    line-height: var(--line-height-relaxed);
    white-space: pre-wrap;
    word-wrap: break-word;
    overflow-wrap: anywhere;
  }
  .cmt__more {
    margin: var(--space-4) auto 0;
    display: block;
    min-height: 44px;
    padding: var(--space-2) var(--space-5);
    border: 2px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-text-strong);
    font: inherit;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }
  .cmt__more:hover {
    background: var(--color-text-strong);
    color: var(--color-text-on-dark);
  }
  .cmt__empty {
    padding: var(--space-5);
    text-align: center;
    color: var(--color-text-muted);
    background: var(--color-bg-soft);
    border: var(--border-thin);
    margin-block-end: var(--space-7);
  }

  /* ---------- Formulário ---------- */
  .cmt__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-5);
    background: var(--color-bg-soft);
    border: var(--border-thin);
  }
  .cmt__form-title {
    margin: 0;
    font-size: var(--font-size-h3);
  }
  .cmt__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .cmt__label {
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-strong);
  }
  .cmt__input,
  .cmt__textarea {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-canvas);
    border: 2px solid var(--color-border-strong);
    color: var(--color-text-strong);
    font: inherit;
    min-height: 44px;
  }
  .cmt__textarea {
    min-height: 96px;
    resize: vertical;
    line-height: var(--line-height-normal);
  }
  .cmt__counter {
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    align-self: end;
    font-variant-numeric: tabular-nums;
  }
  .cmt__honeypot {
    position: absolute;
    inset-inline-start: -9999px;
    opacity: 0;
    pointer-events: none;
  }
  .cmt__actions {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .cmt__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-5);
    border: 2px solid var(--color-brand-primary);
    background: var(--color-brand-primary);
    color: var(--color-text-on-brand);
    font: inherit;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }
  .cmt__btn:hover { background: var(--color-brand-primary-hover); border-color: var(--color-brand-primary-hover); }
  .cmt__btn[disabled] { opacity: 0.5; cursor: progress; pointer-events: none; }
  .cmt__error {
    padding: var(--space-3) var(--space-4);
    background: var(--color-state-error-bg);
    color: var(--color-state-error);
    border-inline-start: 4px solid var(--color-state-error);
    font-weight: var(--font-weight-semibold);
  }
  .cmt__success {
    padding: var(--space-3) var(--space-4);
    background: var(--color-state-success-bg);
    color: var(--color-state-success);
    border-inline-start: 4px solid var(--color-state-success);
    font-weight: var(--font-weight-semibold);
  }
  .cmt__hint {
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
    margin: 0;
  }
  .cmt__turnstile { min-height: 65px; }
</style>

<script>
  const TURNSTILE_KEY = (window as any).__CDB_TURNSTILE_KEY__ as string | undefined;

  type Comment = {
    id: number;
    page_id: string;
    nickname: string;
    message: string;
    created_at: number;
  };

  function escapeHtml(s: string): string {
    return s
      .replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;")
      .replace(/"/g, "&quot;").replace(/'/g, "&#39;");
  }

  function formatTime(ms: number): string {
    const date = new Date(ms);
    const now = Date.now();
    const diff = now - ms;
    const mins = Math.round(diff / 60000);
    if (mins < 1) return "agora há pouco";
    if (mins < 60) return `${mins} min atrás`;
    const hours = Math.round(mins / 60);
    if (hours < 24) return `${hours} h atrás`;
    const days = Math.round(hours / 24);
    if (days < 7) return `${days} dias atrás`;
    return date.toLocaleDateString("pt-BR", { day: "2-digit", month: "short", year: "numeric" });
  }

  function renderItem(c: Comment): string {
    return `
      <li class="cmt__item">
        <div class="cmt__head">
          <span class="cmt__nick">${escapeHtml(c.nickname)}</span>
          <span class="cmt__time" title="${new Date(c.created_at).toISOString()}">${formatTime(c.created_at)}</span>
        </div>
        <p class="cmt__msg">${escapeHtml(c.message)}</p>
      </li>`;
  }

  function setup(mount: HTMLElement) {
    const endpoint = mount.dataset.endpoint!;
    const pageId = mount.dataset.pageId!;
    const pageTitle = mount.dataset.pageTitle ?? "";
    const pageUrl = mount.dataset.pageUrl ?? "";

    let oldestId: number | null = null;
    let hasMore = false;
    let firstLoadDone = false;

    function shellHtml(): string {
      return `
        <ul class="cmt__list" data-cmt-list aria-live="polite"></ul>
        <p class="cmt__empty" data-cmt-empty hidden>Nenhum comentário ainda. Seja o primeiro.</p>
        <button type="button" class="cmt__more" data-cmt-more hidden>Carregar mais</button>

        <form class="cmt__form" data-cmt-form novalidate>
          <h3 class="cmt__form-title">Deixe seu comentário</h3>
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" class="cmt__honeypot">

          <div class="cmt__field">
            <label class="cmt__label" for="cmt-nick-${pageId.replace(/[^a-z0-9]/gi, "")}">Apelido</label>
            <input
              id="cmt-nick-${pageId.replace(/[^a-z0-9]/gi, "")}"
              class="cmt__input"
              type="text"
              name="nickname"
              maxlength="50"
              required
              autocomplete="nickname"
              placeholder="ex.: maria do bairro"
            >
          </div>

          <div class="cmt__field">
            <label class="cmt__label" for="cmt-msg-${pageId.replace(/[^a-z0-9]/gi, "")}">Comentário</label>
            <textarea
              id="cmt-msg-${pageId.replace(/[^a-z0-9]/gi, "")}"
              class="cmt__textarea"
              name="message"
              rows="4"
              maxlength="1000"
              required
              placeholder="O que achou? Como foi a visita?"
            ></textarea>
            <span class="cmt__counter" data-cmt-counter>0 / 1000</span>
          </div>

          ${TURNSTILE_KEY ? `<div class="cmt__turnstile"><div class="cf-turnstile" data-sitekey="${escapeHtml(TURNSTILE_KEY)}" data-theme="light" data-appearance="interaction-only" data-language="pt-br"></div></div>` : ""}

          <p class="cmt__hint">
            Seu apelido aparece publicamente junto com a mensagem. Não pedimos
            email. Não inclua dados pessoais.
          </p>

          <div data-cmt-feedback></div>

          <div class="cmt__actions">
            <button type="submit" class="cmt__btn" data-cmt-submit>Comentar</button>
          </div>
        </form>
      `;
    }

    async function fetchPage(before: number | null): Promise<{ items: Comment[] }> {
      const url = new URL(endpoint + "/api/comments");
      url.searchParams.set("pageId", pageId);
      url.searchParams.set("limit", "20");
      if (before !== null) url.searchParams.set("before", String(before));
      const res = await fetch(url.toString(), { method: "GET", headers: { Accept: "application/json" } });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      return res.json();
    }

    async function loadInitial() {
      try {
        mount.innerHTML = shellHtml();
        bindForm();
        const list = mount.querySelector<HTMLUListElement>("[data-cmt-list]")!;
        const empty = mount.querySelector<HTMLElement>("[data-cmt-empty]")!;
        const more = mount.querySelector<HTMLButtonElement>("[data-cmt-more]")!;

        const { items } = await fetchPage(null);
        list.innerHTML = items.map(renderItem).join("");
        if (items.length === 0) empty.hidden = false;
        else if (items.length >= 20) {
          oldestId = items[items.length - 1].id;
          hasMore = true;
          more.hidden = false;
        }
        more.addEventListener("click", loadMore);
        firstLoadDone = true;
      } catch (e) {
        console.warn("[comments] load failed", e);
        mount.innerHTML = `<p class="comments__placeholder">Não foi possível carregar comentários agora.</p>`;
      }
    }

    async function loadMore() {
      if (!hasMore || oldestId === null) return;
      const more = mount.querySelector<HTMLButtonElement>("[data-cmt-more]")!;
      more.disabled = true;
      more.textContent = "Carregando…";
      try {
        const { items } = await fetchPage(oldestId);
        const list = mount.querySelector<HTMLUListElement>("[data-cmt-list]")!;
        list.insertAdjacentHTML("beforeend", items.map(renderItem).join(""));
        if (items.length < 20) { hasMore = false; more.hidden = true; }
        else oldestId = items[items.length - 1].id;
      } catch {
        more.textContent = "Erro — tentar de novo";
      } finally {
        more.disabled = false;
        if (hasMore) more.textContent = "Carregar mais";
      }
    }

    function bindForm() {
      const form = mount.querySelector<HTMLFormElement>("[data-cmt-form]")!;
      const counter = mount.querySelector<HTMLElement>("[data-cmt-counter]")!;
      const textarea = form.querySelector<HTMLTextAreaElement>('textarea[name="message"]')!;
      const feedback = mount.querySelector<HTMLElement>("[data-cmt-feedback]")!;
      const submit = mount.querySelector<HTMLButtonElement>("[data-cmt-submit]")!;

      const updateCounter = () => {
        counter.textContent = `${textarea.value.length} / 1000`;
      };
      textarea.addEventListener("input", updateCounter);
      updateCounter();

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        feedback.innerHTML = "";

        const data = new FormData(form);
        if (String(data.get("website") ?? "").trim()) {
          // honeypot — fingir sucesso
          feedback.innerHTML = `<p class="cmt__success">Obrigado!</p>`;
          form.reset();
          return;
        }
        const nickname = String(data.get("nickname") ?? "").trim();
        const message = String(data.get("message") ?? "").trim();
        if (!nickname || !message) {
          feedback.innerHTML = `<p class="cmt__error">Apelido e comentário são obrigatórios.</p>`;
          return;
        }

        // Adiciona contexto da página
        data.set("pageId", pageId);
        data.set("pageTitle", pageTitle);
        data.set("pageUrl", pageUrl);

        submit.disabled = true;
        submit.textContent = "Enviando…";

        try {
          const res = await fetch(endpoint + "/api/comments", {
            method: "POST",
            body: data,
            headers: { Accept: "application/json" },
          });
          if (res.status === 429) {
            feedback.innerHTML = `<p class="cmt__error">Você comentou recentemente. Espere um pouco antes de comentar de novo.</p>`;
            return;
          }
          if (res.status === 403) {
            feedback.innerHTML = `<p class="cmt__error">Verificação anti-bot falhou. Tente recarregar a página.</p>`;
            return;
          }
          if (!res.ok) throw new Error(`HTTP ${res.status}`);
          const json = await res.json() as { item: Comment };
          // Prepend novo comentário
          const list = mount.querySelector<HTMLUListElement>("[data-cmt-list]")!;
          const empty = mount.querySelector<HTMLElement>("[data-cmt-empty]")!;
          list.insertAdjacentHTML("afterbegin", renderItem(json.item));
          empty.hidden = true;
          feedback.innerHTML = `<p class="cmt__success">Comentário publicado.</p>`;
          form.reset();
          updateCounter();
          // Reseta Turnstile pra próximo envio
          if ((window as any).turnstile?.reset) (window as any).turnstile.reset();
        } catch (err) {
          console.warn("[comments] submit failed", err);
          feedback.innerHTML = `<p class="cmt__error">Não foi possível enviar agora. Tente de novo.</p>`;
        } finally {
          submit.disabled = false;
          submit.textContent = "Comentar";
        }
      });
    }

    // Lazy load: só fetcha quando a seção entra na viewport
    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (e.isIntersecting && !firstLoadDone) {
            io.disconnect();
            loadInitial();
            break;
          }
        }
      }, { rootMargin: "200px 0px" });
      io.observe(mount);
    } else {
      loadInitial();
    }
  }

  for (const el of document.querySelectorAll<HTMLElement>("[data-comments-mount]")) {
    setup(el);
  }
</script>

{turnstileKey && (
  <>
    <script is:inline define:vars={{ turnstileKey }}>
      window.__CDB_TURNSTILE_KEY__ = turnstileKey;
    </script>
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    ></script>
  </>
)}
