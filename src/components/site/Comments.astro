---
/**
 * Comments — comentários via giscus (ADR-0007).
 *
 * Pré-requisitos no GitHub:
 * - Discussions habilitadas no repo (Settings → Features).
 * - App giscus instalado (https://github.com/apps/giscus).
 *
 * O tema custom é servido a partir do próprio site
 * (public/giscus-theme.css) → resulta numa URL absoluta no domínio do site,
 * usada pelo iframe do giscus para estilizar o widget.
 */

interface Props {
  mapping?: "pathname" | "url" | "title";
  category?: string;
  categoryId?: string;
  repoId?: string;
}

const {
  mapping = "pathname",
  category = "General",
  categoryId = "DIC_kwDOSYTFec4C8odd",
  repoId = "R_kgDOSYTFeQ",
} = Astro.props;

const repo = "phbruce/comida-di-buteco-better-ux";

// URL ABSOLUTA do nosso CSS custom — necessária porque o giscus
// carrega o tema dentro de um iframe em giscus.app (cross-origin).
// `Astro.site` é definido em astro.config.mjs (https://phbruce.github.io).
// `import.meta.env.BASE_URL` é "/comida-di-buteco-better-ux/".
const themeUrl = new URL(
  "giscus-theme.css",
  new URL(import.meta.env.BASE_URL, Astro.site).toString()
).toString();
---

<section class="comments" aria-labelledby="comments-title">
  <div class="container">
    <h2 id="comments-title" class="comments__title">Comentários</h2>
    <p class="comments__lede">
      Já visitou? Conta sua experiência. Comentários usam o sistema de
      <a href="https://github.com/features/discussions" rel="noopener">GitHub Discussions</a> —
      é necessário ter conta no GitHub para comentar.
    </p>

    <p class="comments__theme-debug" aria-hidden="true">
      <small>
        <code>data-theme</code>:
        <a href={themeUrl} rel="noopener"><code>{themeUrl}</code></a>
      </small>
    </p>

    <div class="comments__mount">
      <noscript>
        <p>
          Comentários precisam de JavaScript habilitado.
          Você ainda pode <a href={`https://github.com/${repo}/discussions`} rel="noopener">
            abrir uma discussão diretamente no GitHub
          </a>.
        </p>
      </noscript>

      {/* Script tag direto no HTML — todos os data-* visíveis em "View Source",
          incluindo data-theme apontando para o nosso CSS custom. O próprio
          iframe interno do giscus já carrega lazy via data-loading="lazy". */}
      <script
        is:inline
        src="https://giscus.app/client.js"
        data-repo={repo}
        data-repo-id={repoId}
        data-category={category}
        data-category-id={categoryId}
        data-mapping={mapping}
        data-strict="0"
        data-reactions-enabled="1"
        data-emit-metadata="0"
        data-input-position="top"
        data-theme={themeUrl}
        data-lang="pt"
        data-loading="lazy"
        crossorigin="anonymous"
        async
      ></script>
    </div>
  </div>
</section>

<style>
  .comments {
    padding-block: var(--space-7);
    border-block-start: var(--border-thin);
  }
  .comments__title {
    font-size: var(--font-size-h2);
    margin-block-end: var(--space-3);
  }
  .comments__lede {
    color: var(--color-text-muted);
    max-width: 60ch;
    margin-block-end: var(--space-4);
  }
  .comments__theme-debug {
    margin-block-end: var(--space-4);
    color: var(--color-text-muted);
    font-size: var(--font-size-caption);
    word-break: break-all;
  }
  .comments__theme-debug code {
    background: var(--color-bg-soft);
    padding: 1px 4px;
    font-size: 0.95em;
  }
  .comments__mount {
    min-height: 200px;
  }
  .comments__mount :global(.giscus-frame) {
    color-scheme: light;
  }
</style>
