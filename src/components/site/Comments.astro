---
/**
 * Comments — comentários via Cusdis (ADR-0008, supersede ADR-0007).
 *
 * Cusdis é open source, free hosted (cusdis.com), permite comentários
 * anônimos OU com nome+email — visitante NÃO precisa de conta.
 *
 * Setup do dono (5 min, uma vez só):
 * 1. Criar conta em https://cusdis.com (free, sem cartão).
 * 2. Criar projeto, pegar APP_ID.
 * 3. Definir env PUBLIC_CUSDIS_APP_ID no workflow de deploy
 *    (ou em .env.production local).
 *
 * Sem APP_ID, o componente mostra fallback informativo.
 */

interface Props {
  /** ID único da página (ex.: cidade/slug). Cusdis usa para agrupar threads. */
  pageId: string;
  pageTitle: string;
  pageUrl: string;
}

const { pageId, pageTitle, pageUrl } = Astro.props;

// APP_ID padrão do projeto Cusdis criado em 2026-05-09 para este redesign.
// Pode ser sobrescrito via env PUBLIC_CUSDIS_APP_ID.
const DEFAULT_APP_ID = "2d491a46-a7cc-48ce-ba2b-86a6265c499e";
const APP_ID = (import.meta.env.PUBLIC_CUSDIS_APP_ID as string | undefined) || DEFAULT_APP_ID;
const HOST = (import.meta.env.PUBLIC_CUSDIS_HOST as string | undefined) ?? "https://cusdis.com";
const SCRIPT = `${HOST}/js/cusdis.es.js`;
---

<section class="comments" aria-labelledby="comments-title">
  <div class="container">
    <h2 id="comments-title" class="comments__title">Comentários</h2>
    <p class="comments__lede">
      Comente sua experiência neste buteco. Você pode comentar sem cadastro
      (apenas nome). Se informar e-mail, recebe aviso quando houver resposta —
      nunca é exibido publicamente.
    </p>

    {APP_ID ? (
      <>
        <div
          id="cusdis_thread"
          class="comments__thread"
          data-host={HOST}
          data-app-id={APP_ID}
          data-page-id={pageId}
          data-page-url={pageUrl}
          data-page-title={pageTitle}
          data-theme="light"
        >
          <p class="comments__loading" aria-live="polite">Carregando comentários…</p>
        </div>
        <script is:inline async defer src={SCRIPT}></script>
      </>
    ) : (
      <div class="comments__fallback">
        <p>
          <strong>Comentários ainda não estão configurados.</strong>
        </p>
        <p>
          Para ativar: criar projeto grátis em
          <a href="https://cusdis.com" rel="noopener">cusdis.com</a>,
          copiar o <code>APP_ID</code> e definir
          <code>PUBLIC_CUSDIS_APP_ID</code> no workflow de deploy
          (<code>.github/workflows/deploy.yml</code>).
        </p>
      </div>
    )}
  </div>
</section>

<style>
  .comments {
    padding-block: var(--space-7);
    border-block-start: var(--border-thin);
  }
  .comments__title {
    font-size: var(--font-size-h2);
    margin-block-end: var(--space-3);
  }
  .comments__lede {
    color: var(--color-text-muted);
    max-width: 60ch;
    margin-block-end: var(--space-5);
  }
  .comments__fallback {
    padding: var(--space-5);
    background: var(--color-bg-soft);
    border: var(--border-thin);
    color: var(--color-text-muted);
  }
  .comments__fallback p { margin: 0; }
  .comments__fallback p + p { margin-block-start: var(--space-2); }
  .comments__fallback code {
    background: var(--color-bg-canvas);
    padding: 1px 4px;
    border: var(--border-thin);
    font-size: 0.92em;
  }

  /* Reserva espaço para o widget Cusdis para não colapsar antes do iframe carregar.
     Quando o iframe entra, ele substitui o texto de loading. */
  .comments__thread {
    min-height: 360px;
    background: var(--color-bg-soft);
    border: var(--border-thin);
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .comments__loading {
    margin: 0;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    text-align: center;
    padding: var(--space-5);
  }
  /* Quando o iframe é injetado pelo cusdis.es.js, o texto "Carregando…"
     fica oculto pelo iframe (que vem depois), e o iframe ocupa o espaço.
     Garante que o iframe não estoure a largura do container. */
  .comments__thread iframe {
    width: 100% !important;
    max-width: 100%;
    border: 0;
    background: var(--color-bg-canvas);
  }
</style>

<style is:global>
  /* Override do tema Cusdis para casar com o "Buteco Moderno" (sem shadow DOM) */
  #cusdis_thread {
    --cusdis-bg: var(--color-bg-canvas);
    --cusdis-text: var(--color-text-strong);
    --cusdis-text-muted: var(--color-text-muted);
    --cusdis-border: var(--color-border);
    --cusdis-primary: var(--color-brand-primary);

    color: var(--cusdis-text);
    background: var(--cusdis-bg);
  }
  #cusdis_thread input,
  #cusdis_thread textarea,
  #cusdis_thread button {
    border-radius: 0 !important;
    font-family: var(--font-family-sans);
  }
  #cusdis_thread input,
  #cusdis_thread textarea {
    border: 2px solid var(--color-border-strong) !important;
    background: var(--color-bg-canvas) !important;
    color: var(--color-text-strong) !important;
    padding: var(--space-3) var(--space-4) !important;
  }
  #cusdis_thread input:focus-visible,
  #cusdis_thread textarea:focus-visible,
  #cusdis_thread button:focus-visible {
    outline: 3px solid var(--color-focus-ring) !important;
    outline-offset: 2px !important;
    box-shadow: 0 4px 0 0 var(--color-focus-text) !important;
  }
  #cusdis_thread button {
    background: var(--color-brand-primary) !important;
    color: var(--color-text-on-brand) !important;
    border: 2px solid var(--color-brand-primary) !important;
    padding: var(--space-2) var(--space-5) !important;
    font-weight: var(--font-weight-semibold) !important;
    min-height: 44px !important;
  }
  #cusdis_thread button:hover {
    background: var(--color-brand-primary-hover) !important;
    border-color: var(--color-brand-primary-hover) !important;
  }
  #cusdis_thread a {
    color: var(--color-brand-primary) !important;
    text-decoration: underline !important;
    text-underline-offset: 0.2em !important;
  }
</style>
