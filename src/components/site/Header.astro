---
/**
 * Header — cabeçalho do site.
 *
 * Layout em grid responsivo:
 *
 * Mobile (<768px) — 2 linhas quando há cidade:
 *   ┌─────────────────────────────────────────┐
 *   │ [CdB] Comida di Buteco   Cidades · Sobre │
 *   ├─────────────────────────────────────────┤
 *   │ Belo Horizonte                Trocar    │
 *   └─────────────────────────────────────────┘
 *
 * Desktop (≥768px) — tudo na mesma linha, com tagline visível.
 */

interface Props {
  cidadeAtual?: string;
}

const { cidadeAtual } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeUrl = base;
const cidadesUrl = `${base}#cidades`;
const concursoUrl = `${base}concurso/`;
const sobreUrl = `${base}sobre/`;
---

<header class="site-header" role="banner">
  <div class="site-header__inner container">
    <a class="site-header__brand" href={homeUrl} aria-label="Comida di Buteco — página inicial">
      <span class="site-header__brand-mark" aria-hidden="true">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" focusable="false">
          {/* Garrafa long-neck silhueta paper-cut sharp — alinha o brand
              mark ao mesmo vocabulário visual dos motivos vegetais (ADR-0016).
              Polígono fechado: tampa → gargalo → ombro → corpo. */}
          <g fill="currentColor">
            <polygon points="10,2 14,2 14,4 13,4 13,8 16,11 16,21 8,21 8,11 11,8 11,4 10,4"/>
          </g>
        </svg>
      </span>
      <span class="site-header__brand-text">
        <span class="site-header__brand-name">Comida di Buteco</span>
        <span class="site-header__brand-tagline">Redesign não oficial</span>
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Principal">
      <a href={cidadesUrl}>Cidades</a>
      <a href={concursoUrl}>Concurso</a>
      <a href={sobreUrl}>Sobre</a>
    </nav>

    {cidadeAtual && (
      <p class="site-header__city">
        <span class="visually-hidden">Cidade selecionada:</span>
        <strong>{cidadeAtual}</strong>
        <a href={homeUrl} class="site-header__city-change">Trocar</a>
      </p>
    )}
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-bg-canvas);
    border-block-end: var(--border-strong);
  }
  .site-header__inner {
    display: grid;
    /* mobile: 2 colunas (brand cresce, nav fixo) */
    grid-template-columns: 1fr auto;
    gap: var(--space-3);
    align-items: center;
    padding-block: var(--space-3);
  }

  /* ---------- Brand ---------- */
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-strong);
    text-decoration: none;
    min-width: 0;
  }
  .site-header__brand:hover .site-header__brand-name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .site-header__brand:hover { color: var(--color-brand-primary); }

  .site-header__brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background-color: var(--color-brand-primary);
    color: var(--color-text-on-brand);
    flex-shrink: 0;
  }
  .site-header__brand-mark svg {
    width: 78%;
    height: 78%;
    display: block;
  }

  .site-header__brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
    min-width: 0;
  }
  .site-header__brand-name {
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-body);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .site-header__brand-tagline {
    /* Em mobile a tagline some — economia de espaço */
    display: none;
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    font-weight: var(--font-weight-regular);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  /* ---------- Nav ---------- */
  .site-header__nav {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    font-size: var(--font-size-small);
  }
  .site-header__nav a {
    color: var(--color-brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    font-weight: var(--font-weight-semibold);
    padding: var(--space-2) 0;
    /* tap target mínimo 44px verticalmente via padding-block do container */
  }
  .site-header__nav a:hover {
    color: var(--color-brand-primary-hover);
    text-decoration-thickness: 2px;
  }

  /* ---------- City pill ----------
     Mobile: ocupa a linha inteira abaixo do brand+nav.
     Desktop: inline à direita. */
  .site-header__city {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-2) var(--space-3);
    background-color: var(--color-bg-soft);
    border: var(--border-thin);
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
  }
  .site-header__city strong {
    color: var(--color-text-strong);
    font-weight: var(--font-weight-semibold);
  }
  .site-header__city-change {
    margin-inline-start: auto;
    font-size: var(--font-size-caption);
    color: var(--color-brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
    font-weight: var(--font-weight-semibold);
    min-height: 32px;
    display: inline-flex;
    align-items: center;
    padding-inline: var(--space-2);
  }
  .site-header__city-change:hover {
    color: var(--color-brand-primary-hover);
    text-decoration-thickness: 2px;
  }

  /* ---------- Breakpoints ---------- */

  @media (min-width: 480px) {
    .site-header__brand-mark {
      width: 44px;
      height: 44px;
      font-size: 1rem;
    }
    .site-header__brand-name {
      font-size: var(--font-size-h3);
    }
    .site-header__brand-tagline {
      display: inline;
    }
    .site-header__nav {
      font-size: var(--font-size-body);
      gap: var(--space-4);
    }
  }

  @media (min-width: 768px) {
    .site-header__inner {
      /* desktop: brand | nav | city, tudo numa linha */
      grid-template-columns: auto 1fr auto;
    }
    .site-header__nav {
      justify-self: end;
      gap: var(--space-5);
    }
    .site-header__city {
      grid-column: auto;
      justify-self: end;
    }
  }
</style>
