---
/**
 * Header — cabeçalho do site.
 * Contém o logo (texto), navegação principal e seletor de cidade.
 *
 * Mobile-first: layout vertical com botão de menu (a partir da Fase 4 vira drawer).
 * Por enquanto, links visíveis em md+ e empilhados em mobile via flex wrap.
 */

interface Props {
  cidadeAtual?: string;
}

const { cidadeAtual } = Astro.props;
const base = import.meta.env.BASE_URL;
const homeUrl = base;
const cidadesUrl = `${base}#cidades`;
const sobreUrl = `${base}sobre/`;
---

<header class="site-header" role="banner">
  <div class="site-header__inner container">
    <a class="site-header__brand" href={homeUrl} aria-label="Comida di Buteco — página inicial">
      <span class="site-header__brand-mark" aria-hidden="true">CdB</span>
      <span class="site-header__brand-text">
        <span class="site-header__brand-name">Comida di Buteco</span>
        <span class="site-header__brand-tagline">Concurso · Edição em curso</span>
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Principal">
      <a href={cidadesUrl}>Cidades</a>
      <a href={sobreUrl}>Sobre</a>
    </nav>

    {cidadeAtual && (
      <p class="site-header__city">
        <span class="visually-hidden">Cidade selecionada:</span>
        <strong>{cidadeAtual}</strong>
        <a href={homeUrl} class="site-header__city-change">Trocar</a>
      </p>
    )}
  </div>
</header>

<style>
  .site-header {
    background-color: var(--color-bg-canvas);
    border-block-end: var(--border-strong);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
    padding-block: var(--space-3);
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text-strong);
    text-decoration: none; /* logo/wordmark — convenção: sem underline */
    margin-inline-end: auto;
  }
  .site-header__brand:hover .site-header__brand-name {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .site-header__brand:hover {
    color: var(--color-brand-primary);
  }
  .site-header__brand-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background-color: var(--color-brand-primary);
    color: var(--color-text-on-brand);
    font-weight: var(--font-weight-bold);
    font-size: 0.875rem;
    letter-spacing: 0.02em;
    border-radius: var(--radius-md);
    flex-shrink: 0;
  }
  .site-header__brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
  }
  .site-header__brand-name {
    font-weight: var(--font-weight-bold);
    font-size: var(--font-size-h3);
  }
  .site-header__brand-tagline {
    font-size: var(--font-size-caption);
    color: var(--color-text-muted);
    font-weight: var(--font-weight-regular);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .site-header__nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }
  .site-header__nav a {
    color: var(--color-brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    font-weight: var(--font-weight-semibold);
    padding: var(--space-2) var(--space-1);
  }
  .site-header__nav a:hover {
    color: var(--color-brand-primary-hover);
    text-decoration-thickness: 2px;
  }

  .site-header__city {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
    background-color: var(--color-bg-soft);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-md);
    border: var(--border-thin);
  }
  .site-header__city strong {
    color: var(--color-text-strong);
  }
  .site-header__city-change {
    font-size: var(--font-size-caption);
    color: var(--color-brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (min-width: 480px) {
    .site-header__brand-mark {
      width: 48px;
      height: 48px;
      font-size: 1rem;
    }
  }
</style>
