---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/ui/Breadcrumb.astro";
import Button from "~/components/ui/Button.astro";
import Tag from "~/components/ui/Tag.astro";
import Map from "~/components/site/Map.astro";
import { butecosBH } from "~/data/butecos-bh";

export async function getStaticPaths() {
  return butecosBH.map((b) => ({
    params: { slug: b.slug },
    props: { buteco: b },
  }));
}

interface Props {
  buteco: typeof butecosBH[number];
}

const { buteco } = Astro.props;
const base = import.meta.env.BASE_URL;

const enderecoFicticio = `${buteco.bairro}, Belo Horizonte – MG`;
const horarioFicticio = "Ter–Sáb · 18h–00h · Dom · 12h–17h";
const telefoneFicticio = "+55 31 0000-0000";

const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${buteco.nome} ${buteco.bairro} Belo Horizonte`)}`;
const oficialVotoUrl = "https://comidadibuteco.com.br/butecos/belo-horizonte/";

const crumbs = [
  { label: "Início", href: base },
  { label: "Belo Horizonte", href: `${base}butecos/belo-horizonte/` },
  { label: buteco.nome },
];
---

<BaseLayout
  title={`${buteco.nome} — ${buteco.prato}`}
  description={`${buteco.nome} apresenta "${buteco.prato}" no concurso Comida di Buteco em ${buteco.bairro}, Belo Horizonte. ${buteco.pratoDescricao ?? ""}`}
  cidadeAtual="Belo Horizonte"
  ogImage={buteco.foto}
>
  <Breadcrumb items={crumbs} />

  <article class="buteco">
    <header class="buteco__hero">
      <div class="buteco__media">
        <img
          src={buteco.foto}
          alt={buteco.fotoAlt}
          width="1200"
          height="750"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="buteco__intro container">
        <div class="buteco__tags">
          {buteco.premiadoEmEdicao && <Tag variant="accent">Vencedor anterior</Tag>}
          {buteco.novato && <Tag variant="info">Estreante</Tag>}
          <Tag variant="neutral">{buteco.bairro}</Tag>
        </div>
        <h1 class="buteco__title">{buteco.nome}</h1>
        <p class="buteco__lede">
          Prato concorrente: <strong>{buteco.prato}</strong>
        </p>
      </div>
    </header>

    <div class="container buteco__layout">
      <section class="buteco__main" aria-labelledby="prato">
        <h2 id="prato">O prato</h2>
        <p class="buteco__prato-desc">
          {buteco.pratoDescricao ?? "Descrição do prato em breve."}
        </p>

        {buteco.premios && buteco.premios.length > 0 && (
          <>
            <h2 id="premios">Histórico</h2>
            <ul class="buteco__premios">
              {buteco.premios.map((p) => <li>{p}</li>)}
            </ul>
          </>
        )}

        <div class="buteco__share" aria-labelledby="share">
          <h2 id="share">Compartilhar</h2>
          <p>
            <a
              href={`https://wa.me/?text=${encodeURIComponent(`${buteco.nome} no Comida di Buteco BH: ${buteco.prato}. Site oficial: https://comidadibuteco.com.br/`)}`}
              rel="noopener"
            >
              Compartilhar no WhatsApp
            </a>
          </p>
        </div>
      </section>

      <aside class="buteco__aside" aria-labelledby="info">
        <h2 id="info" class="visually-hidden">Informações práticas</h2>

        {buteco.coords ? (
          <Map
            lat={buteco.coords.lat}
            lng={buteco.coords.lng}
            label={buteco.nome}
            enderecoTextual={enderecoFicticio}
            mapsUrl={mapsUrl}
          />
        ) : (
          <div class="buteco__card">
            <h3>Onde fica</h3>
            <address>{enderecoFicticio}</address>
            <p>
              <a href={mapsUrl} rel="noopener">Como chegar (Google Maps)</a>
            </p>
          </div>
        )}

        <div class="buteco__card">
          <h3>Horário</h3>
          <p>{horarioFicticio}</p>
        </div>

        <div class="buteco__card">
          <h3>Contato</h3>
          <p>
            <a href={`tel:${telefoneFicticio.replace(/\D/g, "")}`}>{telefoneFicticio}</a>
          </p>
          <p class="buteco__hint">
            Dados de contato e horário são <strong>placeholders</strong>; este é um redesign não oficial.
          </p>
        </div>

        <div class="buteco__card buteco__card--cta">
          <h3>Quer votar?</h3>
          <p>
            A votação acontece no site oficial do concurso.
          </p>
          <Button href={oficialVotoUrl} variant="primary" block>
            Ir para a votação oficial
          </Button>
          <p class="buteco__hint">
            Você sai deste redesign e vai para
            <a href={oficialVotoUrl} rel="noopener">comidadibuteco.com.br</a>.
          </p>
        </div>
      </aside>
    </div>
  </article>
</BaseLayout>

<style>
  .buteco {
    padding-block-end: var(--space-9);
  }

  .buteco__hero {
    margin-block-end: var(--space-6);
  }
  .buteco__media {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-bg-soft);
    border-block-end: var(--border-thin);
  }
  .buteco__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .buteco__intro {
    padding-block: var(--space-5) 0;
  }
  .buteco__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-end: var(--space-3);
  }
  .buteco__title {
    font-size: var(--font-size-display);
    margin-block-end: var(--space-3);
    text-wrap: balance;
  }
  .buteco__lede {
    font-size: var(--font-size-h3);
    color: var(--color-text-muted);
    max-width: 50ch;
  }
  .buteco__lede strong {
    color: var(--color-text-strong);
  }

  .buteco__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-7);
    margin-block-start: var(--space-6);
  }
  .buteco__main h2 {
    margin-block: var(--space-6) var(--space-3);
  }
  .buteco__main h2:first-child {
    margin-block-start: 0;
  }
  .buteco__prato-desc {
    font-size: var(--font-size-body);
    line-height: var(--line-height-relaxed);
    max-width: 65ch;
  }
  .buteco__premios {
    padding-inline-start: 1.25em;
    color: var(--color-text-muted);
  }
  .buteco__premios li {
    margin-block-end: var(--space-1);
  }

  .buteco__aside {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .buteco__card {
    border: var(--border-thin);
    border-radius: var(--radius-md);
    background: var(--color-surface);
    padding: var(--space-5);
  }
  .buteco__card h3 {
    margin-block-end: var(--space-2);
    font-size: var(--font-size-body);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }
  .buteco__card p {
    margin: 0;
  }
  .buteco__card p + p {
    margin-block-start: var(--space-2);
  }
  .buteco__card--cta {
    background: var(--color-text-strong);
    color: var(--color-text-on-dark);
    border-color: var(--color-text-strong);
  }
  .buteco__card--cta h3 {
    color: var(--color-brand-accent);
  }
  .buteco__card--cta p {
    color: var(--color-text-on-dark);
  }
  .buteco__card--cta a {
    color: var(--color-brand-accent);
  }
  .buteco__hint {
    font-size: var(--font-size-small);
    color: var(--color-text-muted);
  }
  .buteco__card--cta .buteco__hint {
    color: rgba(251, 247, 240, 0.75);
  }

  .buteco__share {
    margin-block-start: var(--space-7);
    padding-block-start: var(--space-5);
    border-block-start: var(--border-thin);
  }

  @media (min-width: 1024px) {
    .buteco__layout {
      grid-template-columns: minmax(0, 2fr) minmax(280px, 1fr);
      gap: var(--space-8);
    }
    .buteco__media {
      aspect-ratio: 21 / 9;
    }
  }
</style>
