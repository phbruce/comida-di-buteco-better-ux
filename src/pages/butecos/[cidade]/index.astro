---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Breadcrumb from "~/components/ui/Breadcrumb.astro";
import ButecoListItem from "~/components/site/ButecoListItem.astro";
import { butecos, cidades } from "~/data/butecos";

export async function getStaticPaths() {
  return cidades.map((c) => ({
    params: { cidade: c.slug },
    props: { cidade: c },
  }));
}

const { cidade } = Astro.props;
const lista = butecos
  .filter((b) => b.cidade_slug === cidade.slug)
  .sort((a, b) => a.nome.localeCompare(b.nome, "pt-BR"));

const bairros = Array.from(new Set(lista.map((b) => b.bairro).filter(Boolean))) as string[];
bairros.sort((a, b) => a.localeCompare(b, "pt-BR"));

const sugestoes = Array.from(
  new Set([
    ...lista.map((b) => b.nome),
    ...lista.map((b) => b.prato),
  ])
).sort((a, b) => a.localeCompare(b, "pt-BR"));

const base = import.meta.env.BASE_URL;
const datalistId = `sugestoes-${cidade.slug}`;
const PER_PAGE_DEFAULT = 20;
---

<BaseLayout
  title={`Butecos de ${cidade.nome}`}
  description={`${lista.length} butecos em ${cidade.nome} no concurso Comida di Buteco. Redesign não oficial.`}
  cidadeAtual={cidade.nome}
>
  <Breadcrumb items={[
    { label: "Início", href: base },
    { label: cidade.nome },
  ]} />

  <section class="page-header">
    <div class="container">
      <h1>Butecos de {cidade.nome}{cidade.uf ? ` — ${cidade.uf}` : ""}</h1>
      <p class="page-header__lede">
        {lista.length} butecos participantes desta edição.
        {bairros.length > 0 && <> Em {bairros.length} bairros.</>}
      </p>
    </div>
  </section>

  <section class="filters" aria-labelledby="filters-heading" data-filters>
    <div class="container">
      <h2 id="filters-heading" class="visually-hidden">Filtros e busca</h2>

      <form class="filters__form" role="search" method="get" action="" novalidate>
        <div class="field">
          <label class="field__label" for="busca">Buscar</label>
          <p class="field__hint" id="busca-hint">
            Nome do buteco, prato ou bairro. Sugestões aparecem enquanto você digita.
          </p>
          <input
            id="busca"
            name="q"
            type="search"
            list={datalistId}
            placeholder="ex.: feijoada, costela, Santa Tereza"
            aria-describedby="busca-hint"
            autocomplete="off"
            class="field__input"
            data-filter-q
          />
          <datalist id={datalistId}>
            {sugestoes.map((s) => <option value={s}></option>)}
          </datalist>
        </div>

        {bairros.length > 1 && (
          <div class="filters__row">
            <label class="filters__select" for="bairro">
              <span>Bairro</span>
              <select id="bairro" name="bairro" data-filter-bairro>
                <option value="">Todos os bairros ({bairros.length})</option>
                {bairros.map((b) => <option value={b}>{b}</option>)}
              </select>
            </label>

            <label class="filters__select" for="ordem">
              <span>Ordenar</span>
              <select id="ordem" name="ordem" data-filter-ordem>
                <option value="nome">Nome do buteco (A→Z)</option>
                <option value="bairro">Bairro</option>
              </select>
            </label>
          </div>
        )}

        <div class="filters__actions">
          <button type="reset" class="filters__reset" data-filter-reset>Limpar filtros</button>
          <noscript>
            <button type="submit" class="filters__submit">Aplicar</button>
          </noscript>
        </div>
      </form>
    </div>
  </section>

  <section class="results" aria-labelledby="results-heading">
    <div class="container">
      <div class="results__header" data-results-anchor>
        <h2 id="results-heading">
          <span class="results__count" data-results-count>{lista.length}</span>
          de <span data-results-total>{lista.length}</span> butecos
        </h2>
        <p class="results__hint" aria-live="polite" data-results-hint>
          Mostrando todos os butecos.
        </p>
      </div>

      <ul class="results__list" role="list" data-results-list data-per-page={PER_PAGE_DEFAULT}>
        {lista.map((b) => <ButecoListItem buteco={b} />)}
      </ul>

      <p class="results__empty" data-results-empty hidden>
        Nenhum buteco encontrado com esses filtros.
        <button type="button" class="results__clear" data-filter-reset>Limpar filtros</button>
      </p>

      <nav class="pagination" aria-label="Paginação" data-pagination hidden>
        <button type="button" class="pagination__btn pagination__btn--prev" data-pag-prev disabled>
          <span aria-hidden="true">←</span> Anterior
        </button>
        <span class="pagination__status" aria-live="polite" data-pag-status>Página 1</span>
        <button type="button" class="pagination__btn pagination__btn--next" data-pag-next disabled>
          Próxima <span aria-hidden="true">→</span>
        </button>
      </nav>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header { padding-block: var(--space-6) var(--space-7); }
  .page-header h1 { font-size: var(--font-size-h1); margin-block-end: var(--space-3); }
  .page-header__lede { color: var(--color-text-muted); max-width: 60ch; }

  .filters {
    background: var(--color-bg-soft);
    border-block: var(--border-thin);
    padding-block: var(--space-5);
  }
  .filters__form { display: flex; flex-direction: column; gap: var(--space-4); }
  .field { display: flex; flex-direction: column; gap: var(--space-2); }
  .field__label { font-weight: var(--font-weight-semibold); color: var(--color-text-strong); }
  .field__hint { font-size: var(--font-size-small); color: var(--color-text-muted); margin: 0; }
  .field__input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--color-bg-canvas);
    border: 2px solid var(--color-border-strong);
    color: var(--color-text-strong);
    min-height: 44px;
    font: inherit;
  }

  .filters__row { display: grid; grid-template-columns: 1fr; gap: var(--space-4); }
  .filters__select { display: flex; flex-direction: column; gap: var(--space-2); font-weight: var(--font-weight-semibold); }
  .filters__select select {
    appearance: none;
    background:
      linear-gradient(45deg, transparent 50%, var(--color-text-strong) 50%) calc(100% - 18px) 50% / 6px 6px no-repeat,
      linear-gradient(135deg, var(--color-text-strong) 50%, transparent 50%) calc(100% - 12px) 50% / 6px 6px no-repeat,
      var(--color-bg-canvas);
    padding-inline-end: var(--space-7);
    padding-inline-start: var(--space-3);
    min-height: 44px;
    border: 2px solid var(--color-border-strong);
    font: inherit;
    color: var(--color-text-strong);
  }

  .filters__actions { display: flex; gap: var(--space-3); flex-wrap: wrap; }
  .filters__reset, .filters__submit {
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--color-border-strong);
    background: transparent;
    color: var(--color-text-strong);
    font: inherit;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
  }
  .filters__reset:hover {
    background: var(--color-text-strong);
    color: var(--color-text-on-dark);
  }
  .filters__submit {
    background: var(--color-brand-primary);
    color: var(--color-text-on-brand);
    border-color: var(--color-brand-primary);
  }

  .results { padding-block: var(--space-7); }
  .results__header { margin-block-end: var(--space-6); scroll-margin-block-start: var(--space-3); }
  .results__count { color: var(--color-brand-primary); font-variant-numeric: tabular-nums; }
  .results__hint {
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    margin-block-start: var(--space-2);
    min-height: 1.4em;
  }
  .results__list { list-style: none; padding: 0; margin: 0; }
  .results__empty {
    padding: var(--space-7) var(--space-5);
    text-align: center;
    color: var(--color-text-muted);
    background: var(--color-bg-soft);
    border: var(--border-thin);
  }
  .results__clear {
    margin-inline-start: var(--space-2);
    background: transparent;
    border: 2px solid var(--color-border-strong);
    padding: var(--space-2) var(--space-4);
    color: var(--color-text-strong);
    cursor: pointer;
    font: inherit;
    font-weight: var(--font-weight-semibold);
  }
  .results__clear:hover {
    background: var(--color-text-strong);
    color: var(--color-text-on-dark);
  }

  /* Pagination — apenas client-side; oculta sem JS (hidden) */
  .pagination {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-block-start: var(--space-7);
    padding-block: var(--space-5);
    border-block-start: var(--border-thin);
  }
  .pagination__btn {
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    border: 2px solid var(--color-border-strong);
    background: var(--color-bg-canvas);
    color: var(--color-text-strong);
    font: inherit;
    font-weight: var(--font-weight-semibold);
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
  }
  .pagination__btn:not(:disabled):hover {
    background: var(--color-text-strong);
    color: var(--color-text-on-dark);
  }
  .pagination__btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }
  .pagination__status {
    flex: 1;
    text-align: center;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 640px) {
    .filters__row { grid-template-columns: 1fr 1fr; }
  }
</style>

<script>
  type Sort = "nome" | "bairro";

  function normalize(s: string): string {
    return s
      .toLocaleLowerCase("pt-BR")
      .normalize("NFD")
      .replace(/[̀-ͯ]/g, "")
      .trim();
  }

  function debounce<T extends (...a: any[]) => void>(fn: T, ms: number) {
    let h: number | undefined;
    return (...args: Parameters<T>) => {
      window.clearTimeout(h);
      h = window.setTimeout(() => fn(...args), ms);
    };
  }

  const root = document.querySelector<HTMLElement>("[data-filters]");
  const list = document.querySelector<HTMLElement>("[data-results-list]");
  if (root && list) {
    const inputQ = root.querySelector<HTMLInputElement>("[data-filter-q]");
    const selBairro = root.querySelector<HTMLSelectElement>("[data-filter-bairro]");
    const selOrdem = root.querySelector<HTMLSelectElement>("[data-filter-ordem]");
    const resets = document.querySelectorAll<HTMLButtonElement>("[data-filter-reset]");
    const items = Array.from(list.querySelectorAll<HTMLElement>("[data-buteco-item]"));
    const totalEl = document.querySelector<HTMLElement>("[data-results-total]");
    const countEl = document.querySelector<HTMLElement>("[data-results-count]");
    const hintEl = document.querySelector<HTMLElement>("[data-results-hint]");
    const emptyEl = document.querySelector<HTMLElement>("[data-results-empty]");
    const anchor = document.querySelector<HTMLElement>("[data-results-anchor]");

    /* Pagination */
    const pagNav = document.querySelector<HTMLElement>("[data-pagination]");
    const prevBtn = document.querySelector<HTMLButtonElement>("[data-pag-prev]");
    const nextBtn = document.querySelector<HTMLButtonElement>("[data-pag-next]");
    const statusEl = document.querySelector<HTMLElement>("[data-pag-status]");
    const PER_PAGE = parseInt(list.dataset.perPage ?? "20", 10);
    let currentPage = 1;

    if (totalEl) totalEl.textContent = String(items.length);

    function apply(opts?: { resetPage?: boolean }) {
      if (opts?.resetPage) currentPage = 1;

      const q = normalize(inputQ?.value ?? "");
      const bairro = selBairro?.value ?? "";
      const ordem = (selOrdem?.value ?? "nome") as Sort;
      const tokens = q.split(/\s+/).filter(Boolean);

      // 1. filtra
      const matches = items.filter((li) => {
        const haystack = li.dataset.search ?? "";
        const matchQ = tokens.length === 0 || tokens.every((t) => haystack.includes(t));
        const matchBairro = !bairro || (li.dataset.bairro ?? "") === bairro;
        return matchQ && matchBairro;
      });

      // 2. ordena
      matches.sort((a, b) => {
        if (ordem === "bairro") {
          const ba = a.dataset.bairroKey ?? "";
          const bb = b.dataset.bairroKey ?? "";
          if (ba !== bb) return ba.localeCompare(bb);
        }
        return (a.dataset.nomeKey ?? "").localeCompare(b.dataset.nomeKey ?? "");
      });

      // 3. pagina (calcula totalPages, ajusta currentPage se ficou fora)
      const total = matches.length;
      const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
      if (currentPage > totalPages) currentPage = totalPages;
      if (currentPage < 1) currentPage = 1;
      const start = (currentPage - 1) * PER_PAGE;
      const end = start + PER_PAGE;
      const pageItems = matches.slice(start, end);
      const pageSet = new Set(pageItems);

      // 4. atualiza visibilidade — só mostra os da página atual
      for (const li of items) li.hidden = !pageSet.has(li);

      // 5. reordena items visíveis na DOM (preserva ordem da página)
      for (const li of pageItems) list!.appendChild(li);

      // 6. atualiza UI
      if (countEl) countEl.textContent = String(total);
      if (emptyEl) emptyEl.hidden = total !== 0;
      if (hintEl) {
        if (total === 0) {
          hintEl.textContent = "Nenhum buteco com esses filtros.";
        } else if (total <= PER_PAGE) {
          hintEl.textContent =
            total === items.length
              ? `Mostrando todos os ${total} butecos.`
              : `Mostrando ${total} de ${items.length} butecos.`;
        } else {
          const from = start + 1;
          const to = Math.min(end, total);
          hintEl.textContent = `Mostrando ${from}–${to} de ${total} butecos.`;
        }
      }

      if (pagNav && prevBtn && nextBtn && statusEl) {
        if (totalPages <= 1) {
          pagNav.hidden = true;
        } else {
          pagNav.hidden = false;
          prevBtn.disabled = currentPage === 1;
          nextBtn.disabled = currentPage === totalPages;
          statusEl.textContent = `Página ${currentPage} de ${totalPages}`;
        }
      }

      // 7. URL — preserva filtros + página
      const params = new URLSearchParams();
      if (q) params.set("q", inputQ!.value);
      if (bairro) params.set("bairro", bairro);
      if (ordem && ordem !== "nome") params.set("ordem", ordem);
      if (currentPage > 1) params.set("page", String(currentPage));
      const qs = params.toString();
      const url = qs ? `?${qs}` : window.location.pathname;
      history.replaceState(null, "", url);
    }

    function loadFromUrl() {
      const params = new URLSearchParams(window.location.search);
      if (inputQ && params.has("q")) inputQ.value = params.get("q") ?? "";
      if (selBairro && params.has("bairro")) selBairro.value = params.get("bairro") ?? "";
      if (selOrdem && params.has("ordem")) selOrdem.value = params.get("ordem") ?? "nome";
      const pageStr = params.get("page");
      if (pageStr) {
        const n = parseInt(pageStr, 10);
        if (n > 0) currentPage = n;
      }
    }

    function clearAll() {
      if (inputQ) inputQ.value = "";
      if (selBairro) selBairro.value = "";
      if (selOrdem) selOrdem.value = "nome";
      apply({ resetPage: true });
    }

    function scrollToList() {
      anchor?.scrollIntoView({ behavior: "smooth", block: "start" });
    }

    inputQ?.addEventListener("input", debounce(() => apply({ resetPage: true }), 150));
    selBairro?.addEventListener("change", () => apply({ resetPage: true }));
    selOrdem?.addEventListener("change", () => apply({ resetPage: true }));
    resets.forEach((b) => b.addEventListener("click", (e) => { e.preventDefault(); clearAll(); }));

    prevBtn?.addEventListener("click", () => {
      if (currentPage > 1) {
        currentPage--;
        apply();
        scrollToList();
      }
    });
    nextBtn?.addEventListener("click", () => {
      currentPage++;
      apply();
      scrollToList();
    });

    root.querySelector("form")?.addEventListener("submit", (e) => {
      e.preventDefault();
      apply({ resetPage: true });
    });

    loadFromUrl();
    apply();
  }
</script>
