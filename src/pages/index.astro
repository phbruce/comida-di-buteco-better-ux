---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Illustration from "~/components/ui/Illustration.astro";
import { butecos, cidades, edicao } from "~/data/butecos";

const populares = cidades.filter((c) => c.popular);
const outras = cidades.filter((c) => !c.popular);
const base = import.meta.env.BASE_URL;
const totalButecos = butecos.length;
---

<BaseLayout
  title="Encontre seu buteco — Comida di Buteco"
  description={`Redesign não oficial: ${totalButecos} butecos da edição ${edicao} em ${cidades.length} cidades. Explore os pratos concorrentes do concurso Comida di Buteco.`}
>
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <p class="hero__eyebrow">Edição {edicao} · Concurso</p>
        <h1 class="hero__title">
          Onde tem buteco bom <span>perto de você?</span>
        </h1>
        <p class="hero__lede">
          {totalButecos} butecos em {cidades.length} cidades brasileiras competindo
          com pratos autorais. Escolha sua cidade e descubra.
        </p>
      </div>

      {/* Acentos decorativos — escondidos do leitor de tela */}
      <span class="hero__accent hero__accent--pimenta">
        <Illustration kind="pimenta" size="lg" />
      </span>
      <span class="hero__accent hero__accent--folha">
        <Illustration kind="folha" size="md" />
      </span>
      <span class="hero__accent hero__accent--garrafa">
        <Illustration kind="garrafa" size="md" />
      </span>
    </div>
  </section>

  <section class="section" id="cidades" aria-labelledby="cidades-heading">
    <div class="container">
      <div class="section__header">
        <h2 id="cidades-heading">Escolha sua cidade</h2>
        <p>{cidades.length} cidades participam desta edição.</p>
      </div>

      <h3 class="section__subheading">Cidades com mais butecos</h3>
      <ul class="city-grid" role="list">
        {populares.map((c) => (
          <li>
            <a class="city-card" href={`${base}butecos/${c.slug}/`}>
              <span class="city-card__name">{c.nome}</span>
              {c.uf && <span class="city-card__uf">{c.uf}</span>}
              <span class="city-card__count">{c.total} butecos</span>
            </a>
          </li>
        ))}
      </ul>

      {outras.length > 0 && (
        <>
          <h3 class="section__subheading">Outras cidades</h3>
          <ul class="city-list" role="list">
            {outras.map((c) => (
              <li>
                <a class="city-list__link" href={`${base}butecos/${c.slug}/`}>
                  <span class="city-list__name">{c.nome}</span>
                  {c.uf && <span class="city-list__uf">{c.uf}</span>}
                  <span class="city-list__count">{c.total}</span>
                </a>
              </li>
            ))}
          </ul>
        </>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    background:
      radial-gradient(1200px 400px at 90% -50%, rgba(244, 180, 0, 0.18), transparent 60%),
      radial-gradient(900px 300px at 10% 110%, rgba(156, 42, 27, 0.10), transparent 60%),
      var(--color-bg-soft);
    border-block-end: var(--border-thin);
    padding-block: var(--space-8);
    overflow: hidden;
  }
  .hero__inner {
    position: relative;
  }
  .hero__text {
    position: relative;
    z-index: 1;
    max-width: 38ch;
  }
  .hero__eyebrow {
    margin: 0 0 var(--space-3);
    font-size: var(--font-size-caption);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-brand-primary);
  }
  .hero__title {
    font-size: var(--font-size-display);
    line-height: var(--line-height-tight);
    margin-block-end: var(--space-4);
    max-width: 18ch;
  }
  .hero__title span {
    color: var(--color-brand-primary);
  }
  .hero__lede {
    font-size: var(--font-size-body);
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  /* Acentos decorativos — posicionados em torno do texto, peeking
     das bordas com leve rotação para parecer "atirado" na cena. */
  .hero__accent {
    position: absolute;
    pointer-events: none;
    z-index: 0;
    display: inline-flex;
    transform-origin: center;
  }
  .hero__accent--pimenta {
    /* mobile: canto inferior-direito, pendurado da borda */
    inset-block-end: -12px;
    inset-inline-end: -16px;
    transform: rotate(18deg);
  }
  .hero__accent--folha {
    inset-block-start: -8px;
    inset-inline-end: 12%;
    transform: rotate(-22deg);
    opacity: 0.92;
  }
  .hero__accent--garrafa {
    /* só mostra em telas mais largas — mobile já tem 2 acentos */
    display: none;
  }

  @media (min-width: 768px) {
    .hero__inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: var(--space-6);
      align-items: center;
      min-height: 240px;
    }
    .hero__text { max-width: 52ch; }
    .hero__accent--pimenta {
      inset-block-end: auto;
      inset-block-start: 8%;
      inset-inline-end: 6%;
      transform: rotate(14deg);
    }
    .hero__accent--folha {
      inset-block-start: auto;
      inset-block-end: 4%;
      inset-inline-end: 22%;
      transform: rotate(-18deg);
    }
    .hero__accent--garrafa {
      display: inline-flex;
      inset-block-start: 38%;
      inset-inline-end: 28%;
      transform: rotate(-10deg);
    }
  }
  @media (min-width: 1024px) {
    .hero__accent--pimenta {
      inset-inline-end: 10%;
    }
    .hero__accent--garrafa {
      inset-inline-end: 32%;
    }
  }

  .section {
    padding-block: var(--space-8);
  }
  .section__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin-block-end: var(--space-6);
  }
  .section__header p {
    color: var(--color-text-muted);
    margin: 0;
  }
  .section__subheading {
    font-size: var(--font-size-body);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    font-weight: var(--font-weight-semibold);
    margin-block: var(--space-7) var(--space-3);
    padding-block-end: var(--space-2);
    border-block-end: var(--border-thin);
  }

  .city-grid {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }
  .city-card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-2) var(--space-3);
    padding: var(--space-5);
    background: var(--color-surface);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    color: inherit;
    text-decoration: none;
    transition: border-color var(--motion-fast), box-shadow var(--motion-base);
  }
  .city-card:hover {
    border-color: var(--color-text-strong);
    box-shadow: var(--shadow-2);
  }
  .city-card:hover .city-card__name {
    text-decoration-thickness: 2px;
  }
  .city-card__name {
    font-size: var(--font-size-h3);
    font-weight: var(--font-weight-bold);
    color: var(--color-brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-thickness: 1px;
  }
  .city-card__uf {
    font-size: var(--font-size-caption);
    background: var(--color-text-strong);
    color: var(--color-text-on-dark);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    align-self: start;
    letter-spacing: 0.06em;
    height: fit-content;
  }
  .city-card__count {
    grid-column: 1 / -1;
    color: var(--color-text-muted);
    font-size: var(--font-size-small);
  }

  .city-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
    border-block-start: var(--border-thin);
  }
  .city-list li {
    border-block-end: var(--border-thin);
  }
  .city-list__link {
    display: grid;
    grid-template-columns: 1fr auto auto;
    gap: var(--space-3);
    align-items: center;
    padding: var(--space-3) var(--space-2);
    color: var(--color-brand-primary);
    text-decoration: underline;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    font-weight: var(--font-weight-semibold);
  }
  .city-list__link:hover {
    background: var(--color-bg-soft);
    color: var(--color-brand-primary-hover);
    text-decoration-thickness: 2px;
  }
  .city-list__uf {
    color: var(--color-text-muted);
    font-weight: var(--font-weight-regular);
    font-size: var(--font-size-small);
  }
  .city-list__count {
    color: var(--color-text-muted);
    font-weight: var(--font-weight-regular);
    font-size: var(--font-size-small);
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 480px) {
    .city-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 640px) {
    .hero {
      padding-block: var(--space-9);
    }
    .city-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .city-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .city-list {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
